<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Med.Ui.Controls">

  <ControlTheme x:Key="{x:Type controls:SideNavItem}" TargetType="controls:SideNavItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="Transparent"
                CornerRadius="14"
                Padding="16,12"
                Margin="0,3">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <PathIcon Name="Icon"
                      Data="{TemplateBinding IconData}"
                      Width="20" Height="20"
                      Foreground="{DynamicResource Primary}"
                      IsVisible="{TemplateBinding IconData, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="Label"
                       Text="{TemplateBinding Label}"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource OnSurfaceVariant}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ PathIcon#Icon">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
    </Style>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
