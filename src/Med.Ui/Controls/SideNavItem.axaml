<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Med.Ui.Controls">

  <ControlTheme x:Key="{x:Type controls:SideNavItem}" TargetType="controls:SideNavItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="Transparent"
                CornerRadius="20"
                Padding="14,10"
                Margin="0,2">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <PathIcon Name="Icon"
                      Data="{TemplateBinding IconData}"
                      Width="18" Height="18"
                      Foreground="#322F37"
                      VerticalAlignment="Center"
                      IsVisible="{TemplateBinding IconData, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="Label"
                       Text="{TemplateBinding Label}"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="#322F37" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#Label">
      <Setter Property="Foreground" Value="#1D192B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ PathIcon#Icon">
      <Setter Property="Foreground" Value="#1D192B" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
