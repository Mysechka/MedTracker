<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Med.Ui.Controls">

  <ControlTheme x:Key="{x:Type controls:SideNavItem}" TargetType="controls:SideNavItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="Transparent"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Name="Icon"
                      Data="{TemplateBinding IconData}"
                      Width="20" Height="20"
                      Foreground="{DynamicResource Primary}"
                      IsVisible="{TemplateBinding IconData, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="Label"
                       Text="{TemplateBinding Label}"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource OnSurfaceVariant}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
