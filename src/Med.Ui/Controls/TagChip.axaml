<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Med.Ui.Controls">

  <!-- Чип времени по PDF макету (компактный масштаб): будильник слева + текст -->
  <ControlTheme x:Key="{x:Type controls:TagChip}" TargetType="controls:TagChip">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="#F6F1FA"
                BorderBrush="#B8B0C8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8,5,14,5"
                BoxShadow="0 2 4 0 #26000000">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Name="AlarmIcon"
                      Data="{DynamicResource MedIcon_AlarmFilled}"
                      Width="15" Height="15"
                      Foreground="{DynamicResource MedTitle}"
                      VerticalAlignment="Center" />
            <TextBlock Name="LabelText"
                       Text="{TemplateBinding Label}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#4A3E7E" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    </Style>

    <Style Selector="^:selected /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Style>

    <Style Selector="^:selected /template/ TextBlock#LabelText">
      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
