<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Med.Ui.Controls">

  <ControlTheme x:Key="{x:Type controls:BottomNavItem}" TargetType="controls:BottomNavItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Root"
                Background="Transparent"
                Padding="2,4,2,4">
          <StackPanel Orientation="Vertical"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="3">
            <Border Name="IconPill"
                    Background="Transparent"
                    CornerRadius="14"
                    Padding="16,4"
                    HorizontalAlignment="Center">
              <PathIcon Name="Icon"
                        Data="{TemplateBinding IconData}"
                        Width="20" Height="20"
                        Foreground="{DynamicResource OnSurfaceVariant}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="Label"
                       Text="{TemplateBinding Label}"
                       FontSize="11"
                       FontWeight="Medium"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#IconPill">
      <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    </Style>
    <Style Selector="^:selected /template/ PathIcon#Icon">
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    </Style>
    <Style Selector="^:selected /template/ TextBlock#Label">
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
