            <!-- Разделительные меридианные линии часовых зон (каждые 15 градусов) -->
            <Path Stroke="#475569"
                  StrokeThickness="1"
                  StrokeDashArray="3,3"
                  Opacity="0.45"
                  Data="M 20.8,0 L 20.8,500 M 62.5,0 L 62.5,500 M 104.2,0 L 104.2,500 M 145.8,0 L 145.8,500 M 187.5,0 L 187.5,500 M 229.2,0 L 229.2,500 M 270.8,0 L 270.8,500 M 312.5,0 L 312.5,500 M 354.2,0 L 354.2,500 M 395.8,0 L 395.8,500 M 437.5,0 L 437.5,500 M 479.2,0 L 479.2,500 M 520.8,0 L 520.8,500 M 562.5,0 L 562.5,500 M 604.2,0 L 604.2,500 M 645.8,0 L 645.8,500 M 687.5,0 L 687.5,500 M 729.2,0 L 729.2,500 M 770.8,0 L 770.8,500 M 812.5,0 L 812.5,500 M 854.2,0 L 854.2,500 M 895.8,0 L 895.8,500 M 937.5,0 L 937.5,500" />

            <!-- Нулевой меридиан (Гринвич / UTC 0) -->
            <Line StartPoint="500,0" EndPoint="500,500"
                  Stroke="#38BDF8"
                  StrokeThickness="1.5"
                  Opacity="0.55" />

            <!-- Экватор -->
            <Line StartPoint="0,250" EndPoint="1000,250"
                  Stroke="#475569"
                  StrokeThickness="0.8"
                  StrokeDashArray="4,4"
                  Opacity="0.25" />
          </Canvas>
        </Viewbox>

        <!-- Интерактивный холст для кликов, пинов, подсветки полосы и тултипа -->
        <Canvas x:Name="MapCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Cursor="Hand">

          <!-- Подсветка активной вертикальной зоны часового пояса с боковыми границами -->
          <Border x:Name="TimezoneBand"
                  Background="{DynamicResource Primary}"
                  BorderBrush="{DynamicResource Primary}"
                  BorderThickness="1.5,0,1.5,0"
                  Opacity="0.25"
                  IsVisible="False"
                  IsHitTestVisible="False" />

          <!-- Интерактивный гео-пин на карте -->
          <Grid x:Name="PinMarker" Width="20" Height="20" IsVisible="False" IsHitTestVisible="False">
            <Border Width="18" Height="18"
                    CornerRadius="9"
                    Background="{DynamicResource Primary}"
                    Opacity="0.4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            <Border Width="10" Height="10"
                    CornerRadius="5"
                    Background="#EF4444"
                    BorderBrush="#FFFFFF"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 2 6 0 #80000000" />
          </Grid>

          <!-- Всплывающий тултип-бейдж у пина (в стиле Material 3 / Ubuntu) -->
          <Border x:Name="CityTooltip"
                  Background="#E61E293B"
                  BorderBrush="{DynamicResource Primary}"
                  BorderThickness="1.5"
                  CornerRadius="14"
                  Padding="10,5"
                  BoxShadow="0 4 14 0 #70000000"
                  IsVisible="False"
                  IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <PathIcon Data="{DynamicResource MedIcon_Clock}"
                        Width="13" Height="13"
                        Foreground="{DynamicResource Primary}"
                        VerticalAlignment="Center" />
              <StackPanel Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedCity.FullTitle, RelativeSource={RelativeSource AncestorType=controls:TimezoneMapControl}}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#FFFFFF" />
              </StackPanel>
              <Border Background="{DynamicResource Primary}"
                      CornerRadius="6"
                      Padding="6,2"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentTime, RelativeSource={RelativeSource AncestorType=controls:TimezoneMapControl}}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnPrimary}" />
              </Border>
            </StackPanel>
          </Border>

        </Canvas>
      </Panel>

      <!-- Шкала времени по UTC внизу карты (24 часовых пояса) -->
      <Grid Grid.Row="1" Height="26" Background="#141923">
        <UniformGrid Columns="24" Margin="4,0">
          <TextBlock Text="-11" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-10" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-9" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-8" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-7" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-6" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-5" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-4" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-3" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-2" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="-1" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="±0" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+1" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+2" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+3" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+4" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+5" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+6" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+7" FontSize="9" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+8" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+9" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+10" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+11" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Text="+12" FontSize="9" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </UniformGrid>
      </Grid>

    </Grid>
  </Border>
</UserControl>
