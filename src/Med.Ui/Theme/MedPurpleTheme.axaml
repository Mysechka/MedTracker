<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Лавандово-фиолетовая палитра по макетам Figma -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#594383</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#E8DEF8</Color>
      <Color x:Key="OnPrimaryContainerColor">#4F378B</Color>

      <Color x:Key="SecondaryColor">#6750A4</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#EDE4F7</Color>
      <Color x:Key="OnSecondaryContainerColor">#4A3E7E</Color>

      <Color x:Key="TertiaryColor">#7D7491</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#F3E8FF</Color>
      <Color x:Key="OnTertiaryContainerColor">#4A3E7E</Color>

      <Color x:Key="ErrorColor">#BA1A1A</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="OnErrorContainerColor">#410002</Color>

      <Color x:Key="BackgroundColor">#FEF7FF</Color>
      <Color x:Key="OnBackgroundColor">#261E33</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#261E33</Color>
      <Color x:Key="SurfaceVariantColor">#F1ECF6</Color>
      <Color x:Key="OnSurfaceVariantColor">#7E758E</Color>
      <Color x:Key="OutlineColor">#DDD3EB</Color>
      <Color x:Key="OutlineVariantColor">#EBE3F5</Color>

      <Color x:Key="MedContentPanelColor">#F1ECF6</Color>
      <Color x:Key="MedCardSelectedColor">#DDD3EB</Color>
      <Color x:Key="MedSnackbarColor">#FFFFFF</Color>

      <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
      <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource OnPrimaryColor}" />
      <SolidColorBrush x:Key="PrimaryContainer" Color="{StaticResource PrimaryContainerColor}" />
      <SolidColorBrush x:Key="OnPrimaryContainer" Color="{StaticResource OnPrimaryContainerColor}" />
      <SolidColorBrush x:Key="Secondary" Color="{StaticResource SecondaryColor}" />
      <SolidColorBrush x:Key="OnSecondary" Color="{StaticResource OnSecondaryColor}" />
      <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
      <SolidColorBrush x:Key="OnSecondaryContainer" Color="{StaticResource OnSecondaryContainerColor}" />
      <SolidColorBrush x:Key="Tertiary" Color="{StaticResource TertiaryColor}" />
      <SolidColorBrush x:Key="OnTertiary" Color="{StaticResource OnTertiaryColor}" />
      <SolidColorBrush x:Key="TertiaryContainer" Color="{StaticResource TertiaryContainerColor}" />
      <SolidColorBrush x:Key="OnTertiaryContainer" Color="{StaticResource OnTertiaryContainerColor}" />
      <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
      <SolidColorBrush x:Key="OnError" Color="{StaticResource OnErrorColor}" />
      <SolidColorBrush x:Key="ErrorContainer" Color="{StaticResource ErrorContainerColor}" />
      <SolidColorBrush x:Key="OnErrorContainer" Color="{StaticResource OnErrorContainerColor}" />
      <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="OnBackground" Color="{StaticResource OnBackgroundColor}" />
      <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="OnSurface" Color="{StaticResource OnSurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceVariant" Color="{StaticResource SurfaceVariantColor}" />
      <SolidColorBrush x:Key="OnSurfaceVariant" Color="{StaticResource OnSurfaceVariantColor}" />
      <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
      <SolidColorBrush x:Key="OutlineVariant" Color="{StaticResource OutlineVariantColor}" />

      <SolidColorBrush x:Key="MedContentPanel" Color="{StaticResource MedContentPanelColor}" />
      <SolidColorBrush x:Key="MedCardSelected" Color="{StaticResource MedCardSelectedColor}" />
      <SolidColorBrush x:Key="MedSnackbar" Color="{StaticResource MedSnackbarColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#D0BCFF</Color>
      <Color x:Key="OnPrimaryColor">#381E72</Color>
      <Color x:Key="PrimaryContainerColor">#4F378B</Color>
      <Color x:Key="OnPrimaryContainerColor">#E8DEF8</Color>
      <Color x:Key="SecondaryColor">#CCC2DC</Color>
      <Color x:Key="OnSecondaryColor">#332D41</Color>
      <Color x:Key="SecondaryContainerColor">#4A4458</Color>
      <Color x:Key="OnSecondaryContainerColor">#E8DEF8</Color>
      <Color x:Key="TertiaryColor">#EFB8C8</Color>
      <Color x:Key="OnTertiaryColor">#492532</Color>
      <Color x:Key="TertiaryContainerColor">#633B48</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFD8E4</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#1C1B1F</Color>
      <Color x:Key="OnBackgroundColor">#E6E1E5</Color>
      <Color x:Key="SurfaceColor">#1C1B1F</Color>
      <Color x:Key="OnSurfaceColor">#E6E1E5</Color>
      <Color x:Key="SurfaceVariantColor">#49454F</Color>
      <Color x:Key="OnSurfaceVariantColor">#CAC4D0</Color>
      <Color x:Key="OutlineColor">#938F99</Color>
      <Color x:Key="OutlineVariantColor">#49454F</Color>
      <Color x:Key="MedContentPanelColor">#2D2640</Color>
      <Color x:Key="MedCardSelectedColor">#4A4458</Color>
      <Color x:Key="MedSnackbarColor">#2B2930</Color>

      <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
      <SolidColorBrush x:Key="OnPrimary" Color="{StaticResource OnPrimaryColor}" />
      <SolidColorBrush x:Key="PrimaryContainer" Color="{StaticResource PrimaryContainerColor}" />
      <SolidColorBrush x:Key="OnPrimaryContainer" Color="{StaticResource OnPrimaryContainerColor}" />
      <SolidColorBrush x:Key="Secondary" Color="{StaticResource SecondaryColor}" />
      <SolidColorBrush x:Key="OnSecondary" Color="{StaticResource OnSecondaryColor}" />
      <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
      <SolidColorBrush x:Key="OnSecondaryContainer" Color="{StaticResource OnSecondaryContainerColor}" />
      <SolidColorBrush x:Key="Tertiary" Color="{StaticResource TertiaryColor}" />
      <SolidColorBrush x:Key="OnTertiary" Color="{StaticResource OnTertiaryColor}" />
      <SolidColorBrush x:Key="TertiaryContainer" Color="{StaticResource TertiaryContainerColor}" />
      <SolidColorBrush x:Key="OnTertiaryContainer" Color="{StaticResource OnTertiaryContainerColor}" />
      <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
      <SolidColorBrush x:Key="OnError" Color="{StaticResource OnErrorColor}" />
      <SolidColorBrush x:Key="ErrorContainer" Color="{StaticResource ErrorContainerColor}" />
      <SolidColorBrush x:Key="OnErrorContainer" Color="{StaticResource OnErrorContainerColor}" />
      <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="OnBackground" Color="{StaticResource OnBackgroundColor}" />
      <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="OnSurface" Color="{StaticResource OnSurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceVariant" Color="{StaticResource SurfaceVariantColor}" />
      <SolidColorBrush x:Key="OnSurfaceVariant" Color="{StaticResource OnSurfaceVariantColor}" />
      <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
      <SolidColorBrush x:Key="OutlineVariant" Color="{StaticResource OutlineVariantColor}" />
      <SolidColorBrush x:Key="MedContentPanel" Color="{StaticResource MedContentPanelColor}" />
      <SolidColorBrush x:Key="MedCardSelected" Color="{StaticResource MedCardSelectedColor}" />
      <SolidColorBrush x:Key="MedSnackbar" Color="{StaticResource MedSnackbarColor}" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
