<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Глобальное правило: ContentPresenter сохраняет CornerRadius родительской кнопки на всех состояниях (pointerover, pressed) -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
  </Style>

  <!-- Глобальное правило видимого выделения текста при двойном клике или выделении мышью -->
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="TextPresenter">
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="TextBox /template/ TextPresenter">
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="TextBox /template/ TextPresenter#PART_TextPresenter">
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
  </Style>

  <!-- Акцентная кнопка-пилюля Material 3 по PDF макету -->
  <Style Selector="Button.MedPill">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPill /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedPill:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <!-- Заблокированное состояние кнопки (серая пилюля как на скриншоте ограничения мессенджеров) -->
  <Style Selector="Button.MedPill:disabled">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Cursor" Value="No" />
  </Style>
  <Style Selector="Button.MedPill:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#D4D4D8" />
    <Setter Property="Foreground" Value="#71717A" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Кнопка "Сегодня" в верхнем левом углу боковой панели (компактный масштаб) -->
  <Style Selector="Button.MedTodayNavBtn">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="Foreground" Value="#261E33" />
    <Setter Property="Width" Value="124" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedTodayNavBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="Foreground" Value="#261E33" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedTodayNavBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#DFD2F5" />
    <Setter Property="Foreground" Value="#1D192B" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.MedTodayNavBtn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#D5C4F3" />
    <Setter Property="Foreground" Value="#1D192B" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- Вторичная кнопка-пилюля -->
  <Style Selector="Button.MedPillSecondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPillSecondary /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPillSecondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedPillSecondary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Опасная/деструктивная кнопка-пилюля (красная) -->
  <Style Selector="Button.MedPillDanger">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPillDanger /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPillDanger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#B91C1C" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedPillDanger:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#991B1B" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Круглая кнопка с иконкой (настройки, назад) -->
  <Style Selector="Button.MedCircle">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedCircle /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedCircle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Secondary}" />
    <Setter Property="CornerRadius" Value="21" />
  </Style>
  <Style Selector="Button.MedCircle:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="21" />
  </Style>

  <!-- Приятный кастомный переключатель Material Design 3 Switch (крестик при выключении, галка при включении) -->
  <Style Selector="ToggleSwitch, ToggleSwitch.MedM3Switch">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto" VerticalAlignment="Center" Background="Transparent">
          <Border Name="SwitchTrack"
                  Grid.Column="0"
                  Width="52"
                  Height="30"
                  CornerRadius="15"
                  Background="#E6E0E9"
                  BorderBrush="#79747E"
                  BorderThickness="2">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
            <Canvas Name="PART_MovingKnobs" Width="48" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Name="SwitchThumb"
                      Canvas.Left="3"
                      Canvas.Top="3"
                      Width="20"
                      Height="20"
                      CornerRadius="10"
                      Background="#79747E"
                      BoxShadow="0 1 3 0 #26000000">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                  </Transitions>
                </Border.Transitions>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <!-- Крестик при выключенном состоянии -->
                  <PathIcon Name="SwitchUncheck"
                            Data="{DynamicResource MedIcon_Close}"
                            Width="10" Height="10"
                            Foreground="#E6E0E9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="1">
                    <PathIcon.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                      </Transitions>
                    </PathIcon.Transitions>
                  </PathIcon>
                  <!-- Галочка при включенном состоянии -->
                  <PathIcon Name="SwitchCheck"
                            Data="{DynamicResource MedIcon_Check}"
                            Width="11" Height="11"
                            Foreground="{DynamicResource Primary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0">
                    <PathIcon.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                      </Transitions>
                    </PathIcon.Transitions>
                  </PathIcon>
                </Panel>
              </Border>
            </Canvas>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchThumb, ToggleSwitch.MedM3Switch:pointerover /template/ Border#SwitchThumb">
    <Setter Property="Background" Value="#49454F" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack, ToggleSwitch.MedM3Switch:checked /template/ Border#SwitchTrack">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchThumb, ToggleSwitch.MedM3Switch:checked /template/ Border#SwitchThumb">
    <Setter Property="Canvas.Left" Value="23" />
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchThumb, ToggleSwitch.MedM3Switch:checked:pointerover /template/ Border#SwitchThumb">
    <Setter Property="Background" Value="#F6F1FA" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ PathIcon#SwitchCheck, ToggleSwitch.MedM3Switch:checked /template/ PathIcon#SwitchCheck">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ PathIcon#SwitchUncheck, ToggleSwitch.MedM3Switch:checked /template/ PathIcon#SwitchUncheck">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <!-- Карточка выбора часового пояса в стиле Material Design 3 (Москва / Новосибирск) -->
  <Style Selector="Button.MedZoneCard">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#CAC4D0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.MedZoneCard /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedZoneCard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F7F2FA" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.MedZoneCard.MedZoneCardSelected">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.MedZoneCard.MedZoneCardSelected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedZoneCard.MedZoneCardSelected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#DFD2F5" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <!-- Контейнер рабочей области экрана (пастельно-сиреневый, без внутреннего Padding, чтобы разделители и строки шли от края до края) -->
  <Style Selector="Border.MedContentPanel">
    <Setter Property="Background" Value="{DynamicResource MedContentPanel}" />
    <Setter Property="CornerRadius" Value="22,22,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Заголовок экрана (уменьшенный аккуратный масштаб: 24px) -->
  <Style Selector="TextBlock.MedScreenTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MedTitle}" />
  </Style>

  <!-- Подзаголовок раздела ("Информация", "Теги времени", "Приём лекарства курсом") -->
  <Style Selector="TextBlock.MedSectionHeader">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#49454F" />
  </Style>

  <!-- Подзаголовок раздела фиолетовый ("Часовой пояс", "Приемы пищи", "Привязка мессенджеров") -->
  <Style Selector="TextBlock.MedSectionHeaderPurple">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource MedTitle}" />
  </Style>

  <!-- Поле ввода Material 3 Filled TextField (компактный масштаб) -->
  <Style Selector="Border.MedM3Field">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#49454F" />
    <Setter Property="BorderThickness" Value="0,0,0,1.5" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="12,5,8,4" />
    <Setter Property="Width" Value="210" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Cursor" Value="IBeam" />
  </Style>
  <Style Selector="Border.MedM3Field:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- Внутренний TextBox для Material 3 Filled TextField с собственным чистым шаблоном и видимым выделением текста (#B69DF8) -->
  <Style Selector="TextBox.MedM3Input">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,2,0,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#1D1B20" />
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Cursor="IBeam" Padding="{TemplateBinding Padding}">
          <ScrollViewer Name="PART_ScrollViewer"
                        HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                        VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                        AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}">
            <Panel VerticalAlignment="Center">
              <TextBlock Name="PART_Watermark"
                         Text="{TemplateBinding PlaceholderText}"
                         Foreground="#938F99"
                         FontSize="{TemplateBinding FontSize}"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
              <TextPresenter Name="PART_TextPresenter"
                             Text="{TemplateBinding Text, Mode=TwoWay}"
                             CaretIndex="{TemplateBinding CaretIndex}"
                             SelectionStart="{TemplateBinding SelectionStart}"
                             SelectionEnd="{TemplateBinding SelectionEnd}"
                             TextAlignment="{TemplateBinding TextAlignment}"
                             TextWrapping="{TemplateBinding TextWrapping}"
                             PasswordChar="{TemplateBinding PasswordChar}"
                             RevealPassword="{TemplateBinding RevealPassword}"
                             SelectionBrush="{TemplateBinding SelectionBrush}"
                             SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                             CaretBrush="{TemplateBinding CaretBrush}"
                             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalAlignment="Center" />
            </Panel>
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Совместимость со старым классом MedPdfField -->
  <Style Selector="TextBox.MedPdfField">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#1D1B20" />
    <Setter Property="BorderBrush" Value="#49454F" />
    <Setter Property="BorderThickness" Value="0,0,0,1.5" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="Padding" Value="12,8,36,8" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="TextBox.MedPdfField:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>

  <!-- Кнопка очистки в поле ввода ⊗ -->
  <Style Selector="Button.MedClearBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedClearBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="Button.MedClearBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="Button.MedClearBtn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>

  <!-- Кнопка профиля в шапке -->
  <Style Selector="Button.MedProfileHeaderBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4,4,4" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.MedProfileHeaderBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedProfileHeaderBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedProfileHeaderBtn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Текстовая кнопка-ссылка ("Открыть чат с ботом", "На главную") -->
  <Style Selector="Button.MedTextLinkBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MedTitle}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.MedTextLinkBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.MedTextLinkBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.MedTextLinkBtn:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>

  <!-- Кнопка закрытия (крестик) для модальных окон -->
  <Style Selector="Button.MedCloseBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedCloseBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="Button.MedCloseBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>

  <!-- Плоская строка лекарства во всю ширину панели ("Мои лекарства", Стр. 4 PDF) -->
  <Style Selector="Border.MedMedicationRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,12,20,14" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.MedMedicationRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource MedCardSelected}" />
  </Style>
  <Style Selector="Border.MedMedicationRow.selected">
    <Setter Property="Background" Value="{DynamicResource MedCardSelected}" />
  </Style>
  <Style Selector="Border.MedMedicationRow Button.MedRowEditBtn">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.MedMedicationRow:pointerover Button.MedRowEditBtn">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.MedMedicationRow.selected Button.MedRowEditBtn">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Всплывающая карточка уведомления внизу по центру (Стр. 5, 7, 8 PDF) -->
  <Style Selector="Border.MedBottomDialogCard">
    <Setter Property="Background" Value="#EFEBF4" />
    <Setter Property="BorderBrush" Value="#9E96A8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Width" Value="300" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #30000000" />
  </Style>

  <!-- Чип тега времени в карточке лекарства (Стр. 1, 2, 4 PDF) -->
  <Style Selector="Border.MedTagChipStatic">
    <Setter Property="Background" Value="#F6F1FA" />
    <Setter Property="BorderBrush" Value="#B8B0C8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,4,14,4" />
    <Setter Property="BoxShadow" Value="0 2 4 0 #26000000" />
  </Style>

  <!-- Совместимость: Карточка лекарства/сообщения -->
  <Style Selector="Border.MedCard">
    <Setter Property="Background" Value="{DynamicResource MedSnackbar}" />
    <Setter Property="BorderBrush" Value="#9E96A8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.MedCardSelected">
    <Setter Property="Background" Value="{DynamicResource MedCardSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,12,20,14" />
  </Style>

  <!-- Разделительная тонкая линия во всю ширину под заголовком экрана -->
  <Style Selector="Border.MedHeaderDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Outline}" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <!-- Карточка поля времени (Завтрак, Обед, Ужин — Стр. 3, 7 PDF) -->
  <Style Selector="Border.MedTimeCard">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#E2DAE8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,4,6,4" />
    <Setter Property="Width" Value="110" />
    <Setter Property="Height" Value="38" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #18000000" />
  </Style>
  <Style Selector="Border.MedTimeCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Border.MedTimeCard:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- Внутренний TextBox для поля времени с чистым шаблоном и видимым выделением текста (#B69DF8) -->
  <Style Selector="TextBox.MedTimeInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="Foreground" Value="#1D1B20" />
    <Setter Property="SelectionBrush" Value="#B69DF8" />
    <Setter Property="SelectionForegroundBrush" Value="#1D192B" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent" Cursor="IBeam" Padding="{TemplateBinding Padding}">
          <ScrollViewer Name="PART_ScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
            <TextPresenter Name="PART_TextPresenter"
                           Text="{TemplateBinding Text, Mode=TwoWay}"
                           CaretIndex="{TemplateBinding CaretIndex}"
                           SelectionStart="{TemplateBinding SelectionStart}"
                           SelectionEnd="{TemplateBinding SelectionEnd}"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           SelectionBrush="{TemplateBinding SelectionBrush}"
                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                           CaretBrush="{TemplateBinding CaretBrush}"
                           VerticalAlignment="Center" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Кнопка выпадающего меню времени внутри карточки -->
  <Style Selector="Button.MedTimeChevronBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedTimeChevronBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="Button.MedTimeChevronBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
  </Style>

  <!-- Чипы быстрого выбора времени и масштаба -->
  <Style Selector="Button.MedTimeChip">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#1D1B20" />
    <Setter Property="BorderBrush" Value="#CAC4D0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedTimeChip /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.MedTimeChip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- Кнопка дня в календаре Material 3 DatePicker (идеальный круг 34x34 без растяжения по вертикали) -->
  <Style Selector="Button.MedCalendarDayBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#1D1B20" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="MaxWidth" Value="34" />
    <Setter Property="MaxHeight" Value="34" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn.weekend">
    <Setter Property="Foreground" Value="#8C5870" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EDE3FA" />
    <Setter Property="CornerRadius" Value="17" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn.today">
    <Setter Property="Background" Value="#F5EEFC" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn.today /template/ ContentPresenter">
    <Setter Property="Background" Value="#F5EEFC" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="17" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn.selected">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.MedCalendarDayBtn.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="17" />
  </Style>

  <!-- Унификация шрифта Roboto для всех текстовых стилей Material Theme -->
  <Style Selector="TextBlock.TitleSmall">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.TitleMedium">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.TitleLarge">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.BodySmall">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.BodyMedium">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.BodyLarge">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.HeadlineSmall">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.HeadlineMedium">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.HeadlineLarge">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.LabelSmall">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.LabelMedium">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.LabelLarge">
    <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
  </Style>

</Styles>
