<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Глобальное правило: ContentPresenter сохраняет CornerRadius родительской кнопки на всех состояниях (pointerover, pressed) -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{Binding $parent[Button].CornerRadius}" />
  </Style>

  <!-- Акцентная кнопка-пилюля по PDF макету -->
  <Style Selector="Button.MedPill">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="20,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPill /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedPill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Secondary}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style Selector="Button.MedPill:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- Круглая кнопка с иконкой (настройки, назад) -->
  <Style Selector="Button.MedCircle">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedCircle /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedCircle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Secondary}" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <Style Selector="Button.MedCircle:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>

  <!-- Контейнер рабочей области экрана (пастельно-сиреневый) -->
  <Style Selector="Border.MedContentPanel">
    <Setter Property="Background" Value="{DynamicResource MedContentPanel}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="28,24" />
  </Style>

  <!-- Заголовок экрана (глубокий фиолетовый) -->
  <Style Selector="TextBlock.MedScreenTitle">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
  </Style>

  <!-- Подзаголовок раздела ("Информация", "Теги времени", "Приемы пищи") -->
  <Style Selector="TextBlock.MedSectionHeader">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
  </Style>

  <!-- Поле ввода по PDF: белый фон, тонкая граница, скругление 8px -->
  <Style Selector="TextBox.MedPdfField">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10,40,10" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="TextBox.MedPdfField:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>

  <!-- Кнопка очистки в поле ввода -->
  <Style Selector="Button.MedClearBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedClearBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.MedClearBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.MedClearBtn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- Карточка лекарства/сообщения -->
  <Style Selector="Border.MedCard">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.MedCardSelected">
    <Setter Property="Background" Value="{DynamicResource MedCardSelected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- Кнопка выпадающего времени ("8:00 ∨") -->
  <Style Selector="Button.MedTimePickerBtn">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="100" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.MedTimePickerBtn /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.MedTimePickerBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Разделительная тонкая линия под заголовками -->
  <Style Selector="Border.MedHeaderDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Outline}" />
    <Setter Property="Margin" Value="0,12,0,16" />
  </Style>

  <!-- Глобальный стиль выделения текста для всех TextBox -->
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnPrimaryContainer}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>

  <!-- Карточка поля времени (Завтрак, Обед, Ужин) -->
  <Style Selector="Border.MedTimeCard">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,4,8,4" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.MedTimeCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="Border.MedTimeCard:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- Внутренний TextBox для поля времени: без собственного смещенного фокуса -->
  <Style Selector="TextBox.MedTimeInput">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource OnPrimaryContainer}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
  </Style>
  <Style Selector="TextBox.MedTimeInput /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.MedTimeInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.MedTimeInput:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Кнопка выпадающего меню времени внутри карточки -->
  <Style Selector="Button.MedTimeChevronBtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedTimeChevronBtn /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.MedTimeChevronBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
  </Style>
  <Style Selector="Button.MedTimeChevronBtn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
  </Style>

  <!-- Чипы быстрого выбора времени в Flyout -->
  <Style Selector="Button.MedTimeChip">
    <Setter Property="Background" Value="{DynamicResource SurfaceVariant}" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.MedTimeChip /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.MedTimeChip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryContainer}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
  </Style>

</Styles>
