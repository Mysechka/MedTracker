<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             xmlns:controls="using:Med.Ui.Controls"
             x:Name="Root"
             x:Class="Med.Ui.Views.MainView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource Background}">

  <LayoutTransformControl>
    <LayoutTransformControl.LayoutTransform>
      <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
    </LayoutTransformControl.LayoutTransform>

    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Верхняя панель (Шапка) по PDF (компактный масштаб, без нижней линии, фон #FEF7FF) -->
      <Border Grid.Row="0"
              Background="{DynamicResource Background}"
              BorderThickness="0"
              Padding="14,10,20,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- Логотип MedTracker -->
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="10"
                      VerticalAlignment="Center">
            <Border Width="38" Height="38"
                    CornerRadius="10"
                    Background="#FFFFFF"
                    Padding="3">
              <Image Source="/Assets/app-logo.png"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="MedTracker"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#000000"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- Профиль пользователя (при авторизации) -->
          <Button Grid.Column="2"
                  Classes="MedProfileHeaderBtn"
                  Command="{Binding GoAccountCommand}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsAuthenticated}">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding AccountName}"
                         FontSize="15"
                         FontWeight="Medium"
                         Foreground="#000000"
                         VerticalAlignment="Center" />
              <Grid Width="34" Height="34" VerticalAlignment="Center">
                <Ellipse Width="34"
                         Height="34"
                         Fill="{DynamicResource PrimaryContainer}" />

                <PathIcon Data="{DynamicResource MedIcon_UserOutline}"
                          Width="18" Height="18"
                          Foreground="{DynamicResource MedTitle}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !HasAvatar}" />

                <Ellipse Width="34"
                         Height="34"
                         IsVisible="{Binding HasAvatar}">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding AvatarPath, Converter={x:Static controls:PathToBitmapConverter.Instance}}"
                                Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
              </Grid>
            </StackPanel>
          </Button>

          <!-- Кнопка Вход (если не авторизован) -->
          <Button Grid.Column="2"
                  Classes="MedPill"
                  Content="Вход"
                  Command="{Binding GoAuthCommand}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding !IsAuthenticated}" />
        </Grid>
      </Border>

      <!-- Основное тело -->
      <Grid Grid.Row="1">

        <!-- 1. Десктопная раскладка с боковым меню (Ширина >= 640px) -->
        <Grid ColumnDefinitions="172,*" Margin="12,6,14,0" IsVisible="{Binding !#Root.IsCompact}">
          <!-- Боковое меню навигации -->
          <DockPanel Grid.Column="0" Margin="4,0,10,14">
            <!-- Круглая фиолетовая кнопка настроек внизу слева -->
            <Button DockPanel.Dock="Bottom"
                    Classes="MedCircle"
                    Command="{Binding GoSettingsCommand}"
                    HorizontalAlignment="Left"
                    Margin="4,0,0,0">
              <PathIcon Data="{DynamicResource MedIcon_Settings}"
                        Width="21" Height="21"
                        Foreground="{DynamicResource OnPrimary}" />
            </Button>

            <!-- Пункты меню -->
            <StackPanel Spacing="6" Margin="0,0,0,0">
              <Button Classes="MedTodayNavBtn"
                      Content="Сегодня"
                      Command="{Binding GoTodayCommand}"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,22" />

              <controls:SideNavItem Label="Лекарства"
                                    IconData="{DynamicResource MedIcon_AlarmOutline}"
                                    IsSelected="{Binding IsMedicationsSelected}"
                                    Command="{Binding GoMedicationsCommand}"
                                    HorizontalAlignment="Stretch" />

              <controls:SideNavItem Label="Медкарта"
                                    IconData="{DynamicResource MedIcon_Folder}"
                                    IsSelected="{Binding IsMedicalCardSelected}"
                                    Command="{Binding GoMedicalCardCommand}"
                                    HorizontalAlignment="Stretch" />
            </StackPanel>
          </DockPanel>

          <!-- Область подстановки экранов (Desktop) -->
          <Border Grid.Column="1" Classes="MedContentPanel">
            <Grid>
              <ContentControl Content="{Binding Current}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              IsVisible="{Binding !#Root.IsCompact}" />
              <controls:SnackbarHost DataContext="{Binding Snackbar}"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,16" />
            </Grid>
          </Border>
        </Grid>

        <!-- 2. Мобильная компактная раскладка (Ширина < 640px) -->
        <Border Margin="8,6,8,0"
                Classes="MedContentPanel"
                IsVisible="{Binding #Root.IsCompact}">
          <Grid>
            <ContentControl Content="{Binding Current}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            IsVisible="{Binding #Root.IsCompact}" />
            <controls:SnackbarHost DataContext="{Binding Snackbar}"
                                   VerticalAlignment="Bottom"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />
          </Grid>
        </Border>

      </Grid>

      <!-- Нижняя панель навигации для мобильного режима (Android & iOS) -->
      <Border Grid.Row="2"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource OutlineVariant}"
              BorderThickness="0,1,0,0"
              Padding="4,6,4,18"
              IsVisible="{Binding #Root.IsCompact}">
        <UniformGrid Rows="1" Columns="4">
          <controls:BottomNavItem Label="Сегодня"
                                  IconData="{DynamicResource MedIcon_Calendar}"
                                  IsSelected="{Binding IsTodaySelected}"
                                  Command="{Binding GoTodayCommand}" />
          <controls:BottomNavItem Label="Лекарства"
                                  IconData="{DynamicResource MedIcon_AlarmOutline}"
                                  IsSelected="{Binding IsMedicationsSelected}"
                                  Command="{Binding GoMedicationsCommand}" />
          <controls:BottomNavItem Label="Медкарта"
                                  IconData="{DynamicResource MedIcon_Folder}"
                                  IsSelected="{Binding IsMedicalCardSelected}"
                                  Command="{Binding GoMedicalCardCommand}" />
          <controls:BottomNavItem Label="Настройки"
                                  IconData="{DynamicResource MedIcon_Settings}"
                                  IsSelected="{Binding IsSettingsSelected}"
                                  Command="{Binding GoSettingsCommand}" />
        </UniformGrid>
      </Border>

    </Grid>
  </LayoutTransformControl>
</UserControl>
