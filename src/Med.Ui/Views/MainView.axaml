<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             x:Class="Med.Ui.Views.MainView"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
      <!-- Навигация каркаса: кнопка на экран, выбор View делает ViewLocator. -->
      <Button Content="Auth" Command="{Binding GoAuthCommand}" />
      <Button Content="Сегодня" Command="{Binding GoTodayCommand}" />
      <Button Content="Лекарства" Command="{Binding GoMedicationsCommand}" />
      <Button Content="Курсы" Command="{Binding GoCoursesCommand}" />
      <Button Content="Медкарта" Command="{Binding GoMedicalCardCommand}" />
      <Button Content="Настройки" Command="{Binding GoSettingsCommand}" />
      <Button Content="Диагностика" Command="{Binding GoDiagnosticsCommand}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding Title}" />
      <TextBlock Text="{Binding StatusMessage}" />
    </StackPanel>
    <!-- ScrollViewer нужен не для вида: без него нижние поля длинных экранов недостижимы. -->
    <ScrollViewer>
      <ContentControl Content="{Binding Current}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
