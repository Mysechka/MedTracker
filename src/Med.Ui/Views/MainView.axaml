<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             xmlns:controls="using:Med.Ui.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Med.Ui.Views.MainView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource Background}">

  <Grid RowDefinitions="Auto,*">

    <!-- Шапка -->
    <Border Grid.Row="0"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource OutlineVariant}"
            BorderThickness="0,0,0,1"
            Padding="20,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Image Source="/Assets/app-logo.png"
                 Height="28"
                 Stretch="Uniform" />
          <TextBlock Text="MedTracker"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="{DynamicResource OnSurface}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsAuthenticated}">
          <TextBlock Text="{Binding AccountName}"
                     Foreground="{DynamicResource OnSurface}"
                     VerticalAlignment="Center" />
          <Border Width="36" Height="36"
                  CornerRadius="18"
                  Background="{DynamicResource PrimaryContainer}">
            <PathIcon Data="{DynamicResource Material_IconAccountCircle}"
                      Width="22" Height="22"
                      Foreground="{DynamicResource Primary}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <Button Grid.Column="2"
                Classes="MedPill"
                Content="Вход"
                Command="{Binding GoAuthCommand}"
                IsVisible="{Binding !IsAuthenticated}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="172,*" Margin="8,8,12,12">

      <!-- Боковое меню -->
      <DockPanel Grid.Column="0" Margin="8,12,0,12">
        <Button DockPanel.Dock="Bottom"
                Classes="MedPill"
                Width="44" Height="44"
                Padding="0"
                CornerRadius="22"
                Command="{Binding GoSettingsCommand}"
                HorizontalAlignment="Left"
                Margin="4,0,0,0">
          <PathIcon Data="{DynamicResource Material_IconSettings}"
                    Width="22" Height="22"
                    Foreground="{DynamicResource OnPrimary}" />
        </Button>

        <StackPanel Spacing="4">
          <controls:SideNavItem Label="Сегодня"
                                IsSelected="{Binding IsTodaySelected}"
                                Command="{Binding GoTodayCommand}"
                                Margin="0,0,0,4" />
          <controls:SideNavItem Label="Лекарства"
                                IconData="{DynamicResource Material_IconSchedule}"
                                IsSelected="{Binding IsMedicationsSelected}"
                                Command="{Binding GoMedicationsCommand}" />
          <controls:SideNavItem Label="Медкарта"
                                IconData="{DynamicResource Material_IconFolderShared}"
                                IsSelected="{Binding IsMedicalCardSelected}"
                                Command="{Binding GoMedicalCardCommand}" />
        </StackPanel>
      </DockPanel>

      <!-- Контент -->
      <Border Grid.Column="1"
              Classes="MedContentPanel"
              Margin="8,12,0,0">
        <Grid>
          <ContentControl Content="{Binding Current}" />
          <controls:SnackbarHost DataContext="{Binding Snackbar}"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,16" />
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
