<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             xmlns:material="using:CCSWE.Avalonia.Material"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Med.Ui.Views.MainView"
             x:Name="ShellRoot"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource Surface}">

  <DrawerPage DrawerBehavior="Locked"
              IsOpen="True"
              DrawerLength="280">

    <DrawerPage.DrawerHeader>
      <StackPanel Margin="24,24,24,8" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Source="/Assets/app-icon.png"
                 Width="40" Height="40" />
          <StackPanel VerticalAlignment="Center" Spacing="0">
            <TextBlock Classes="TitleLarge" Text="MedTracker" />
            <TextBlock Classes="BodySmall"
                       Foreground="{DynamicResource OnSurfaceVariant}"
                       Text="Трекер приёма лекарств" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DrawerPage.DrawerHeader>

    <DrawerPage.Drawer>
      <!-- DrawerPage не пробрасывает DataContext в pane — без этого Command не биндятся. -->
      <StackPanel Spacing="4"
                  Margin="12,8,12,8"
                  DataContext="{Binding #ShellRoot.DataContext}">
        <Button Classes="Text"
                Command="{Binding GoTodayCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconToday}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Сегодня" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="Text"
                Command="{Binding GoMedicationsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconMedication}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Лекарства" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="Text"
                Command="{Binding GoCoursesCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconEventRepeat}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Курсы" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="Text"
                Command="{Binding GoMedicalCardCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconFolderShared}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Медкарта" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="Text"
                Command="{Binding GoSettingsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconSettings}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Настройки" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <material:Divider Margin="0,8" />

        <Button Classes="Text"
                Command="{Binding GoAuthCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Padding="16,12">
          <StackPanel Orientation="Horizontal" Spacing="16">
            <PathIcon Data="{DynamicResource Material_IconAccountCircle}"
                      Width="24" Height="24" />
            <TextBlock Classes="LabelLarge" Text="Вход" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </DrawerPage.Drawer>

    <!-- DrawerPage не пробрасывает DataContext в content-slot — см. CCSWE demo App.sample.axaml. -->
    <DockPanel DataContext="{Binding #ShellRoot.DataContext}">
      <Border DockPanel.Dock="Top"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource OutlineVariant}"
              BorderThickness="0,0,0,1"
              Padding="24,16">
        <StackPanel Spacing="4">
          <TextBlock Classes="HeadlineSmall" Text="{Binding ScreenTitle}" />
          <TextBlock Classes="BodyMedium"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <ScrollViewer Padding="24,16">
        <ContentControl Content="{Binding Current}" />
      </ScrollViewer>
    </DockPanel>

  </DrawerPage>
</UserControl>
