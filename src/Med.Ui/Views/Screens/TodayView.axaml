<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Today"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.TodayView"
             x:DataType="vm:TodayViewModel">
  <StackPanel Spacing="16">

    <TextBlock Classes="MedScreenTitle" Text="Сегодня" />
    <Border Height="1" Background="{DynamicResource Outline}" />

    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3" />

    <controls:EmptyState IsVisible="{Binding IsEmpty}"
                         Icon="{DynamicResource Material_IconToday}"
                         Header="На сегодня приёмов нет"
                         Description="Приёмы появятся здесь, когда у активного курса будет расписание на этот день."
                         ActionText="Обновить"
                         ActionCommand="{Binding RefreshCommand}" />

    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource Surface}"
                  CornerRadius="12"
                  Padding="16"
                  Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <TextBlock Grid.Column="0"
                         Classes="TitleMedium"
                         Text="{Binding Time}"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="BodyLarge" Text="{Binding Title}" />
                <TextBlock Classes="BodySmall"
                           Foreground="{DynamicResource OnSurfaceVariant}"
                           Text="{Binding StateText}" />
              </StackPanel>
              <StackPanel Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="MedPill"
                        Content="Принял"
                        Command="{Binding ConfirmCommand}"
                        IsVisible="{Binding CanConfirm}" />
                <Button Classes="Outlined"
                        Content="Пропустить"
                        Command="{Binding SkipCommand}"
                        IsVisible="{Binding CanSkip}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
