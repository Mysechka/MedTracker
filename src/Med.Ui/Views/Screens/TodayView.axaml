<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Today"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.TodayView"
             x:DataType="vm:TodayViewModel">

  <UserControl.Styles>
    <Style Selector="Border.completed">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Border.dose-card.completed">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Заголовок экрана "Сегодня" -->
    <StackPanel Grid.Row="0" Spacing="0">
      <TextBlock Classes="MedScreenTitle" Text="Сегодня" />
      <Border Classes="MedHeaderDivider" />
    </StackPanel>

    <!-- Основная область экрана "Сегодня" -->
    <Grid Grid.Row="1">

      <!-- 1. НЕ АВТОРИЗОВАН: Предупреждение внизу экрана (Стр. 4 PDF) -->
      <Border VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Classes="MedCard"
              CornerRadius="12"
              Padding="24,18"
              MaxWidth="460"
              Margin="0,0,0,24"
              BoxShadow="0 4 16 0 #20000000"
              IsVisible="{Binding !IsAuthenticated}">
        <StackPanel Spacing="8">
          <TextBlock Text="Войдите в аккаунт!"
                     FontWeight="Bold"
                     FontSize="15"
                     Foreground="{DynamicResource OnSurface}" />
          <TextBlock Text="Чтобы продолжить работу приложения, войдите в аккаунт или пройдите процедуру регистрации."
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource OnSurfaceVariant}" />
        </StackPanel>
      </Border>

      <!-- 2. АВТОРИЗОВАН, НО НЕТ НАПОМИНАНИЙ: Карточка по центру (Стр. 9 PDF) -->
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Classes="MedCard"
              CornerRadius="14"
              Padding="48,28"
              BoxShadow="0 2 10 0 #15000000"
              IsVisible="{Binding IsEmpty}">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <PathIcon Data="{DynamicResource MedIcon_Calendar}"
                    Width="24" Height="24"
                    Foreground="{DynamicResource OnSurfaceVariant}"
                    HorizontalAlignment="Center" />
          <TextBlock Text="Напоминаний нету"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurface}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 3. АВТОРИЗОВАН И ЕСТЬ ПРИЁМЫ: Карточка напоминания (Стр. 5 PDF) -->
      <ScrollViewer IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DoseRowViewModel">
              <Border Classes="MedCard"
                      Classes.completed="{Binding IsCompleted}"
                      CornerRadius="12"
                      Padding="20,16"
                      Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">

                    <!-- Левая часть: Время • Статус, Название, "Приближается время для приёма! ▶" -->
                    <StackPanel Grid.Column="0" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsCompleted}">
                        <TextBlock Text="{Binding Time}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Primary}" />
                        <TextBlock Text="•"
                                   FontSize="13"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Title}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource OnSurface}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsApproaching}">
                        <TextBlock Text="{Binding ApproachingText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource OnSurfaceVariant}" />
                        <PathIcon Data="{DynamicResource MedIcon_PlayRight}"
                                  Width="9" Height="9"
                                  Foreground="{DynamicResource Primary}"
                                  VerticalAlignment="Center" />
                      </StackPanel>
                    <TextBlock Text="{Binding Details}"
                               FontSize="13"
                               Foreground="{DynamicResource OnSurfaceVariant}"
                               IsVisible="{Binding HasDetails}" />
                  </StackPanel>

                  <!-- Правая часть: галочка "Лекарство принято", круглая кнопка Назад при пропуске, либо кнопки действий -->
                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center">

                    <!-- Состояние: Лекарство принято (Галочка + надпись + кнопка отмены) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsTaken}">
                      <Border Background="#E8F5E9"
                              CornerRadius="20"
                              Padding="12,6,16,6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                          <Border Width="20" Height="20"
                                  CornerRadius="10"
                                  Background="#2E7D32">
                            <PathIcon Data="{DynamicResource MedIcon_Check}"
                                      Width="11" Height="11"
                                      Foreground="#FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="Лекарство принято"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     Foreground="#2E7D32"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Button Classes="MedCircle"
                              Width="34" Height="34"
                              CornerRadius="17"
                              Command="{Binding UndoCommand}"
                              ToolTip.Tip="Отменить приём"
                              VerticalAlignment="Center">
                        <PathIcon Data="{DynamicResource MedIcon_ArrowBack}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource OnPrimary}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                      </Button>
                    </StackPanel>

                    <!-- Состояние: Лекарство пропущено (Надпись + круглая кнопка Назад со стрелкой) -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsSkipped}">
                      <Border Background="{DynamicResource OutlineVariant}"
                              CornerRadius="20"
                              Padding="12,6,12,6">
                        <TextBlock Text="Пропущено"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{DynamicResource OnSurfaceVariant}"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Button Classes="MedCircle"
                              Width="34" Height="34"
                              CornerRadius="17"
                              Command="{Binding UndoCommand}"
                              ToolTip.Tip="Отменить пропуск"
                              VerticalAlignment="Center">
                        <PathIcon Data="{DynamicResource MedIcon_ArrowBack}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource OnPrimary}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                      </Button>
                    </StackPanel>

                    <!-- Кнопки действий: Принял / Пропустить -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanConfirm}">
                      <Button Classes="MedPill"
                              Content="Принял"
                              Command="{Binding ConfirmCommand}" />
                      <Button Classes="MedPill"
                              Content="Пропустить"
                              Command="{Binding SkipCommand}"
                              Background="{DynamicResource OutlineVariant}"
                              Foreground="{DynamicResource OnSurface}" />
                    </StackPanel>

                  </StackPanel>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Grid>

    <ProgressBar Grid.Row="1"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 VerticalAlignment="Bottom" />

  </Grid>
</UserControl>
