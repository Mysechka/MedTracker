<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Account"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.AccountView"
             x:DataType="vm:AccountViewModel">

  <UserControl.Styles>
    <!-- Карточка секции экрана "Аккаунт" -->
    <Style Selector="Border.MedAccountCard">
      <Setter Property="Background" Value="#F8F2FC" />
      <Setter Property="BorderBrush" Value="#D5C8E5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="22,18" />
    </Style>

    <!-- Контурная кнопка выхода из аккаунта (спокойный красный акцент) -->
    <Style Selector="Button.MedPillDangerOutline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B3261E" />
      <Setter Property="BorderBrush" Value="#C4514B" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.MedPillDangerOutline /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B3261E" />
      <Setter Property="BorderBrush" Value="#C4514B" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.MedPillDangerOutline:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFDAD6" />
      <Setter Property="Foreground" Value="#93000A" />
      <Setter Property="BorderBrush" Value="#B3261E" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="Button.MedPillDangerOutline:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#F9BFC0" />
      <Setter Property="Foreground" Value="#690005" />
      <Setter Property="BorderBrush" Value="#93000A" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- Круглая кнопка-карандаш поверх аватара -->
    <Style Selector="Button.MedAvatarEditBadge">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
      <Setter Property="BorderBrush" Value="#F8F2FC" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.MedAvatarEditBadge /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Primary}" />
      <Setter Property="BorderBrush" Value="#F8F2FC" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.MedAvatarEditBadge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Secondary}" />
      <Setter Property="BorderBrush" Value="#F8F2FC" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>

    <!-- Контурный чип статуса бота в правой карточке -->
    <Style Selector="Border.MedBotStatusChip">
      <Setter Property="Background" Value="#FBF8FF" />
      <Setter Property="BorderBrush" Value="#49454F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Основное содержимое экрана Аккаунт (заголовок зафиксирован, контент скроллируется) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- Заголовок экрана -->
      <DockPanel Grid.Row="0" Margin="24,16,24,12">
        <TextBlock Classes="MedScreenTitle" Text="Аккаунт" />
      </DockPanel>

      <!-- Разделительная линия во всю ширину панели -->
      <Border Grid.Row="1" Classes="MedHeaderDivider" />

      <!-- Скроллируемая область профиля -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18"
                    Background="Transparent"
                    MaxWidth="820"
                    HorizontalAlignment="Stretch"
                    Margin="24,18,24,48">

          <!-- 1. ВЕРХНЯЯ КАРТОЧКА ПРОФИЛЯ (Hero Card) -->
          <Border Classes="MedAccountCard" Padding="22,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">

              <!-- Аватар с круглой кнопкой-карандашом в правом нижнем углу -->
              <Grid Grid.Column="0"
                    Width="88"
                    Height="88"
                    VerticalAlignment="Center">
                <Ellipse Width="88"
                         Height="88"
                         Fill="{DynamicResource PrimaryContainer}" />

                <PathIcon Data="{DynamicResource MedIcon_UserOutline}"
                          Width="42" Height="42"
                          Foreground="{DynamicResource MedTitle}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsVisible="{Binding !HasAvatar}" />

                <Ellipse Width="88"
                         Height="88"
                         IsVisible="{Binding HasAvatar}">
                  <Ellipse.Fill>
                    <ImageBrush Source="{Binding AvatarPath, Converter={x:Static controls:PathToBitmapConverter.Instance}}"
                                Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>

                <Button Classes="MedAvatarEditBadge"
                        Command="{Binding ChangeAvatarCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        ToolTip.Tip="Сменить фото">
                  <PathIcon Data="{DynamicResource MedIcon_Pencil}"
                            Width="13" Height="13"
                            Foreground="{DynamicResource OnPrimary}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Button>
              </Grid>

              <!-- Центральная часть: Поле Имя пользователя + бейдж режима + кнопка сохранения -->
              <WrapPanel Grid.Column="1"
                         Orientation="Horizontal"
                         VerticalAlignment="Center">

                <!-- Поле Имя пользователя -->
                <Border Classes="MedM3Field"
                        Width="250"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="0,4,14,4">
                  <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="Имя пользователя"
                               FontSize="11"
                               Foreground="#49454F"
                               IsHitTestVisible="False" />
                    <TextBox Classes="MedM3Input"
                             MaxLength="20"
                             Text="{Binding Username}" />
                  </StackPanel>
                </Border>

                <!-- Бейдж: Локальный режим -->
                <Border Background="#E5D8F6"
                        CornerRadius="14"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Margin="0,4,12,4"
                        IsVisible="{Binding IsLocalOnly}">
                  <TextBlock Text="Локальный режим"
                             FontSize="12"
                             FontWeight="Medium"
                             Foreground="#2B2240" />
                </Border>

                <!-- Бейдж: Облачный режим -->
                <Border Background="#E5D8F6"
                        CornerRadius="14"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Margin="0,4,12,4"
                        IsVisible="{Binding !IsLocalOnly}">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{DynamicResource MedIcon_Check}"
                              Width="12" Height="12"
                              Foreground="{DynamicResource Primary}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Облачный режим"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#2B2240"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Border>

                <!-- Кнопка сохранения изменений имени/профиля (появляется при редактировании) -->
                <Button Classes="MedPill"
                        Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        VerticalAlignment="Center"
                        Margin="0,4,0,4"
                        IsVisible="{Binding HasChanges}" />
              </WrapPanel>

              <!-- Правая часть: Контурная кнопка Выйти из аккаунта -->
              <Button Grid.Column="2"
                      Classes="MedPillDangerOutline"
                      Content="Выйти из аккаунта"
                      Command="{Binding SignOutCommand}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right" />

            </Grid>
          </Border>

          <!-- 2. НИЖНЯЯ ДВУХКОЛОНОЧНАЯ СЕТКА КАРТОЧЕК -->
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

            <!-- ЛЕВАЯ КАРТОЧКА: Привязка аккаунта (или настройки облачного входа) -->
            <Border Grid.Column="0" Classes="MedAccountCard">
              <StackPanel Spacing="12">

                <!-- Вариант А: Локальный режим — Привязка аккаунта к облаку -->
                <StackPanel Spacing="12" IsVisible="{Binding IsLocalOnly}">
                  <TextBlock Text="Привязка аккаунта"
                             FontSize="19"
                             FontWeight="Bold"
                             Foreground="#1D1B20" />

                  <TextBlock Text="Привяжите email и пароль для синхронизации с облаком и подключения ботов:"
                             FontSize="13"
                             LineHeight="18"
                             Foreground="#322F37"
                             TextWrapping="Wrap" />

                  <Border Classes="MedM3Field"
                          Width="NaN"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="Почта" FontSize="11" Foreground="#49454F" IsHitTestVisible="False" />
                      <TextBox Classes="MedM3Input" Text="{Binding LinkEmail}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="MedM3Field"
                          Width="NaN"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="Пароль" FontSize="11" Foreground="#49454F" IsHitTestVisible="False" />
                      <TextBox Classes="MedM3Input" Text="{Binding LinkPassword}" PasswordChar="•" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{Binding LinkErrorMessage}"
                             FontSize="12"
                             Foreground="#BA1A1A"
                             TextWrapping="Wrap"
                             IsVisible="{Binding LinkErrorMessage.Length}" />

                  <Button Classes="MedPill"
                          Content="Привязать аккаунт"
                          Command="{Binding LinkAccountCommand}"
                          HorizontalAlignment="Left"
                          Padding="22,10"
                          Margin="0,4,0,0" />
                </StackPanel>

                <!-- Вариант Б: Облачный режим — Почта и смена пароля -->
                <StackPanel Spacing="12" IsVisible="{Binding !IsLocalOnly}">
                  <TextBlock Text="Параметры входа"
                             FontSize="19"
                             FontWeight="Bold"
                             Foreground="#1D1B20" />

                  <TextBlock Text="Ваш аккаунт синхронизирован с облаком. Вы можете обновить почту или задать новый пароль:"
                             FontSize="13"
                             LineHeight="18"
                             Foreground="#322F37"
                             TextWrapping="Wrap" />

                  <Border Classes="MedM3Field"
                          Width="NaN"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="Почта"
                                 FontSize="11"
                                 Foreground="#49454F"
                                 IsHitTestVisible="False" />
                      <TextBox Classes="MedM3Input"
                               Text="{Binding Email}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="MedM3Field"
                          Width="NaN"
                          HorizontalAlignment="Stretch">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                      <TextBlock Text="Пароль"
                                 FontSize="11"
                                 Foreground="#49454F"
                                 IsHitTestVisible="False" />
                      <TextBox Classes="MedM3Input"
                               Text="{Binding NewPassword}"
                               PasswordChar="•" />
                    </StackPanel>
                  </Border>

                  <Button Classes="MedPill"
                          Content="Сохранить изменения"
                          Command="{Binding SaveCommand}"
                          IsEnabled="{Binding HasChanges}"
                          HorizontalAlignment="Left"
                          Padding="22,10"
                          Margin="0,4,0,0" />
                </StackPanel>

                <!-- Сообщение о статусе -->
                <TextBlock Text="{Binding Message}"
                           FontSize="12"
                           Foreground="{DynamicResource Primary}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           IsVisible="{Binding Message.Length}" />

              </StackPanel>
            </Border>

            <!-- ПРАВАЯ КАРТОЧКА: Облако и боты -->
            <Border Grid.Column="1" Classes="MedAccountCard">
              <Grid RowDefinitions="*,Auto,Auto">

                <!-- Верхний список преимуществ облака -->
                <StackPanel Grid.Row="0" Spacing="14">
                  <TextBlock Text="Облако и боты"
                             FontSize="19"
                             FontWeight="Bold"
                             Foreground="#1D1B20" />

                  <StackPanel Spacing="12" Margin="0,2,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <PathIcon Grid.Column="0"
                                Data="{DynamicResource MedIcon_Check}"
                                Width="15" Height="15"
                                Foreground="{DynamicResource Primary}"
                                VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="Резервная копия медкарты и курсов"
                                 FontSize="13"
                                 Foreground="#1D1B20"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <PathIcon Grid.Column="0"
                                Data="{DynamicResource MedIcon_Check}"
                                Width="15" Height="15"
                                Foreground="{DynamicResource Primary}"
                                VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="Синхронизация между macOS и Android"
                                 FontSize="13"
                                 Foreground="#1D1B20"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <PathIcon Grid.Column="0"
                                Data="{DynamicResource MedIcon_Check}"
                                Width="15" Height="15"
                                Foreground="{DynamicResource Primary}"
                                VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="Уведомления в Telegram и Discord"
                                 FontSize="13"
                                 Foreground="#1D1B20"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </StackPanel>

                <!-- Разделительная линия во всю ширину правой карточки -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="#D5C8E5"
                        Margin="-22,16,-22,16" />

                <!-- Нижние статусные чипы Telegram и Discord -->
                <StackPanel Grid.Row="2" Spacing="8">
                  <Border Classes="MedBotStatusChip">
                    <Panel>
                      <TextBlock Text="Telegram: не подключен"
                                 FontSize="13"
                                 Foreground="#1D1B20"
                                 IsVisible="{Binding !IsTelegramLinked}" />
                      <TextBlock Text="Telegram: подключен"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Primary}"
                                 IsVisible="{Binding IsTelegramLinked}" />
                    </Panel>
                  </Border>

                  <Border Classes="MedBotStatusChip">
                    <Panel>
                      <TextBlock Text="Discord: не подключен"
                                 FontSize="13"
                                 Foreground="#1D1B20"
                                 IsVisible="{Binding !IsDiscordLinked}" />
                      <TextBlock Text="Discord: подключен"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource Primary}"
                                 IsVisible="{Binding IsDiscordLinked}" />
                    </Panel>
                  </Border>
                </StackPanel>

              </Grid>
            </Border>

          </Grid>

        </StackPanel>
      </ScrollViewer>

      <!-- Индикатор прогресса -->
      <ProgressBar Grid.Row="3"
                   IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Height="3" />

    </Grid>

    <!-- Модальный оверлей кадрирования (Avatar Crop Overlay) -->
    <Border Background="#A0000000"
            IsVisible="{Binding IsCropping}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ZIndex="100">
      <Border Background="{DynamicResource Surface}"
              CornerRadius="20"
              Padding="24,20"
              MaxWidth="440"
              MaxHeight="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="0 16 48 0 #60000000">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" HorizontalAlignment="Center">

            <Grid ColumnDefinitions="*,Auto" Width="360">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Выбор области"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Primary}" />
                <TextBlock Text="Перетаскивайте фото и настройте масштаб"
                           FontSize="12"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="MedCloseBtn"
                      Command="{Binding CancelCropCommand}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      ToolTip.Tip="Закрыть"
                      Cursor="Hand">
                <PathIcon Data="{DynamicResource MedIcon_Close}"
                          Width="14" Height="14"
                          Foreground="{DynamicResource OnSurfaceVariant}" />
              </Button>
            </Grid>

            <Border Width="280"
                    Height="280"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Background="#18181B"
                    BorderBrush="{DynamicResource OutlineVariant}"
                    BorderThickness="1"
                    Cursor="SizeAll"
                    HorizontalAlignment="Center"
                    PointerPressed="OnCropPointerPressed"
                    PointerMoved="OnCropPointerMoved"
                    PointerReleased="OnCropPointerReleased"
                    PointerCaptureLost="OnCropPointerCaptureLost"
                    PointerWheelChanged="OnCropPointerWheelChanged">
              <Panel Width="280" Height="280">
                <Image Source="{Binding CropSourcePath, Converter={x:Static controls:PathToBitmapConverter.Instance}}"
                       Width="200"
                       Height="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="50%,50%">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding CropZoom}" ScaleY="{Binding CropZoom}" />
                      <TranslateTransform X="{Binding CropPanX}" Y="{Binding CropPanY}" />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>

                <Path Fill="#70000000" IsHitTestVisible="False">
                  <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                      <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,280,280" />
                      </CombinedGeometry.Geometry1>
                      <CombinedGeometry.Geometry2>
                        <EllipseGeometry Rect="40,40,200,200" />
                      </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                  </Path.Data>
                </Path>

                <Ellipse Width="200" Height="200"
                         Stroke="{DynamicResource Primary}"
                         StrokeThickness="2.5"
                         IsHitTestVisible="False" />

                <Ellipse Width="196" Height="196"
                         Stroke="{DynamicResource Primary}"
                         StrokeThickness="1"
                         Opacity="0.4"
                         IsHitTestVisible="False" />
              </Panel>
            </Border>

            <StackPanel Spacing="6" Width="280" HorizontalAlignment="Center">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Масштаб"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource OnSurface}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CropZoom, StringFormat='{}{0:F1}x'}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Primary}" />
              </Grid>

              <Slider Minimum="0.5"
                      Maximum="10.0"
                      Value="{Binding CropZoom}"
                      TickFrequency="0.1"
                      IsSnapToTickEnabled="False" />

              <Button Classes="MedTextLinkBtn"
                      Content="Сбросить положение"
                      Command="{Binding ResetCropPositionCommand}"
                      HorizontalAlignment="Center"
                      FontSize="12"
                      Padding="4,2" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Width="280" Margin="0,4,0,0">
              <Button Grid.Column="0"
                      Classes="MedPillSecondary"
                      Content="Отмена"
                      Command="{Binding CancelCropCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />

              <Button Grid.Column="1"
                      Classes="MedPill"
                      Content="Применить"
                      Command="{Binding ApplyCropCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

  </Grid>

</UserControl>
