<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Account"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.AccountView"
             x:DataType="vm:AccountViewModel">

  <Grid>
    <!-- Основное содержимое экрана Аккаунт (заголовок зафиксирован, контент скроллируется) -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- Заголовок экрана -->
      <TextBlock Grid.Row="0" Classes="MedScreenTitle" Text="Аккаунт" />

      <!-- Разделительная линия -->
      <Border Grid.Row="1" Classes="MedHeaderDivider" />

      <!-- Скроллируемая область профиля -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="0,16,0,0">
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,120">

          <!-- Колонка: Аватарка и кнопка смены фото -->
          <StackPanel Spacing="16" HorizontalAlignment="Center" Width="160" Margin="0,0,32,20">
            <Grid Width="130" Height="130" HorizontalAlignment="Center">
              <!-- Фоновый круг и заглушка (первая буква имени) -->
              <Ellipse Width="130"
                       Height="130"
                       Fill="{DynamicResource PrimaryContainer}"
                       Stroke="{DynamicResource OutlineVariant}"
                       StrokeThickness="2" />

              <TextBlock Text="{Binding AvatarInitial}"
                         FontSize="48"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Primary}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding !HasAvatar}" />

              <!-- Фотография пользователя в идеальном круге -->
              <Ellipse Width="130"
                       Height="130"
                       Stroke="{DynamicResource OutlineVariant}"
                       StrokeThickness="2"
                       IsVisible="{Binding HasAvatar}">
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding AvatarPath, Converter={x:Static controls:PathToBitmapConverter.Instance}}"
                              Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Grid>

            <Button Classes="MedPill"
                    Content="Сменить фото"
                    Command="{Binding ChangeAvatarCommand}"
                    HorizontalAlignment="Center"
                    MinWidth="140"
                    HorizontalContentAlignment="Center" />
          </StackPanel>

          <!-- Колонка: Данные профиля -->
          <StackPanel Spacing="0" MinWidth="260" MaxWidth="420" HorizontalAlignment="Left" Margin="0,0,0,24">

            <!-- Поле Ник -->
            <StackPanel Spacing="6" Margin="0,0,0,16">
              <TextBlock Text="Ник"
                         FontSize="14"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <TextBox Classes="MedPdfField"
                       Text="{Binding Username}"
                       PlaceholderText="Ваш ник" />
            </StackPanel>

            <!-- Поля после привязки почты: Почта и Пароль -->
            <StackPanel Spacing="0" IsVisible="{Binding !IsLocalOnly}">
              <!-- Поле Почта -->
              <StackPanel Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="Почта"
                           FontSize="14"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox Classes="MedPdfField"
                         Text="{Binding Email}"
                         PlaceholderText="name@example.com" />
              </StackPanel>

              <!-- Поле Пароль -->
              <StackPanel Spacing="6" Margin="0,0,0,16">
                <TextBlock Text="Пароль"
                           FontSize="14"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox Classes="MedPdfField"
                         Text="{Binding NewPassword}"
                         PasswordChar="•"
                         PlaceholderText="Новый пароль" />
              </StackPanel>
            </StackPanel>

            <!-- Секция: Привязка аккаунта к облаку (если локальный режим) -->
            <StackPanel Spacing="10" Margin="0,8,0,0" IsVisible="{Binding IsLocalOnly}">
              <TextBlock Classes="MedSectionHeader" Text="Привязка аккаунта" />
              <TextBlock Text="Привяжите email и пароль для синхронизации с облаком и подключения ботов:"
                         FontSize="13"
                         Foreground="{DynamicResource OnSurfaceVariant}"
                         TextWrapping="Wrap" />

              <StackPanel Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="Email" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox Classes="MedPdfField" Text="{Binding LinkEmail}" PlaceholderText="name@example.com" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Пароль" FontSize="13" Foreground="{DynamicResource OnSurfaceVariant}" />
                <TextBox Classes="MedPdfField" Text="{Binding LinkPassword}" PasswordChar="•" PlaceholderText="Не менее 6 символов" />
              </StackPanel>

              <TextBlock Text="{Binding LinkErrorMessage}"
                         FontSize="13"
                         Foreground="#FFD32F2F"
                         TextWrapping="Wrap"
                         IsVisible="{Binding LinkErrorMessage.Length}" />

              <Button Classes="MedPill"
                      Content="Привязать аккаунт"
                      Command="{Binding LinkAccountCommand}"
                      MinWidth="180"
                      HorizontalContentAlignment="Center"
                      Margin="0,4,0,0" />
            </StackPanel>

            <!-- Сообщение о статусе -->
            <TextBlock Text="{Binding Message}"
                       FontSize="13"
                       Foreground="{DynamicResource Primary}"
                       Margin="0,8,0,0"
                       IsVisible="{Binding Message.Length}" />

            <!-- Кнопки действий в самом низу страницы -->
            <StackPanel Spacing="12" HorizontalAlignment="Left" Margin="0,20,0,24">
              <!-- Появляется только при изменении любого поля -->
              <Button Classes="MedPill"
                      Content="Сохранить изменения"
                      Command="{Binding SaveCommand}"
                      MinWidth="200"
                      HorizontalContentAlignment="Center"
                      IsVisible="{Binding HasChanges}" />

              <!-- Кнопка выйти из аккаунта красным цветом -->
              <Button Classes="MedPillDanger"
                      Content="Выйти из аккаунта"
                      Command="{Binding SignOutCommand}"
                      MinWidth="200"
                      HorizontalContentAlignment="Center" />
            </StackPanel>

          </StackPanel>

        </WrapPanel>
      </ScrollViewer>

      <!-- Индикатор прогресса -->
      <ProgressBar Grid.Row="3"
                   IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Height="3"
                   Margin="0,8,0,0" />

    </Grid>

    <!-- Модальный оверлей кадрирования (Avatar Crop Overlay) -->
    <Border Background="#A0000000"
            IsVisible="{Binding IsCropping}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="-28,-24"
            ZIndex="100">
      <Border Background="{DynamicResource Surface}"
              CornerRadius="20"
              Padding="24,20"
              MaxWidth="440"
              MaxHeight="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              BoxShadow="0 16 48 0 #60000000">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" HorizontalAlignment="Center">

            <!-- Шапка модального окна с заголовком и крестиком -->
            <Grid ColumnDefinitions="*,Auto" Width="360">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Выбор области"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Primary}" />
                <TextBlock Text="Перетаскивайте фото и настройте масштаб"
                           FontSize="12"
                           Foreground="{DynamicResource OnSurfaceVariant}" />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="MedCloseBtn"
                      Command="{Binding CancelCropCommand}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      ToolTip.Tip="Закрыть"
                      Cursor="Hand">
                <PathIcon Data="{DynamicResource MedIcon_Close}"
                          Width="14" Height="14"
                          Foreground="{DynamicResource OnSurfaceVariant}" />
              </Button>
            </Grid>

            <!-- Контейнер видоискателя: картинка не обрезается, видна полностью с круговой направляющей маской -->
            <Border Width="280"
                    Height="280"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Background="#18181B"
                    BorderBrush="{DynamicResource OutlineVariant}"
                    BorderThickness="1"
                    Cursor="SizeAll"
                    HorizontalAlignment="Center"
                    PointerPressed="OnCropPointerPressed"
                    PointerMoved="OnCropPointerMoved"
                    PointerReleased="OnCropPointerReleased"
                    PointerCaptureLost="OnCropPointerCaptureLost"
                    PointerWheelChanged="OnCropPointerWheelChanged">
              <Panel Width="280" Height="280">

                <!-- Само изображение: масштабируется и перемещается, не обрезается -->
                <Image Source="{Binding CropSourcePath, Converter={x:Static controls:PathToBitmapConverter.Instance}}"
                       Width="200"
                       Height="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="50%,50%">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding CropZoom}" ScaleY="{Binding CropZoom}" />
                      <TranslateTransform X="{Binding CropPanX}" Y="{Binding CropPanY}" />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>

                <!-- Полупрозрачная маска с круглым прозрачным окном по центру -->
                <Path Fill="#70000000" IsHitTestVisible="False">
                  <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                      <CombinedGeometry.Geometry1>
                        <RectangleGeometry Rect="0,0,280,280" />
                      </CombinedGeometry.Geometry1>
                      <CombinedGeometry.Geometry2>
                        <EllipseGeometry Rect="40,40,200,200" />
                      </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                  </Path.Data>
                </Path>

                <!-- Круглая рамка области аватара -->
                <Ellipse Width="200" Height="200"
                         Stroke="{DynamicResource Primary}"
                         StrokeThickness="2.5"
                         IsHitTestVisible="False" />

                <!-- Тонкая внутренняя направляющая сетка видоискателя -->
                <Ellipse Width="196" Height="196"
                         Stroke="{DynamicResource Primary}"
                         StrokeThickness="1"
                         Opacity="0.4"
                         IsHitTestVisible="False" />
              </Panel>
            </Border>

            <!-- Управление масштабом -->
            <StackPanel Spacing="6" Width="280" HorizontalAlignment="Center">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Масштаб"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource OnSurface}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CropZoom, StringFormat='{}{0:F1}x'}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Primary}" />
              </Grid>

              <Slider Minimum="0.5"
                      Maximum="10.0"
                      Value="{Binding CropZoom}"
                      TickFrequency="0.1"
                      IsSnapToTickEnabled="False" />

              <Button Classes="MedTextLinkBtn"
                      Content="Сбросить положение"
                      Command="{Binding ResetCropPositionCommand}"
                      HorizontalAlignment="Center"
                      FontSize="12"
                      Padding="4,2" />
            </StackPanel>

            <!-- Кнопки действий: Отмена и Применить -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Width="280" Margin="0,4,0,0">
              <Button Grid.Column="0"
                      Classes="MedPillSecondary"
                      Content="Отмена"
                      Command="{Binding CancelCropCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />

              <Button Grid.Column="1"
                      Classes="MedPill"
                      Content="Применить"
                      Command="{Binding ApplyCropCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

  </Grid>

</UserControl>
