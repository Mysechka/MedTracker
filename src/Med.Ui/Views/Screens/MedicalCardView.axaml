<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.MedicalCard"
             x:Class="Med.Ui.Views.Screens.MedicalCardView"
             x:DataType="vm:MedicalCardViewModel">
  <Grid RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="16">
      <TextBlock Classes="MedScreenTitle" Text="Моя медкарта" />
      <Border Height="1" Background="{DynamicResource Outline}" />
    </StackPanel>

    <Border Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Background="{DynamicResource MedSnackbar}"
            CornerRadius="12"
            Padding="20,16"
            MaxWidth="420"
            BoxShadow="0 4 16 0 #28000000"
            Margin="0,0,0,24"
            IsVisible="{Binding ShowDevelopmentNotice}">
      <StackPanel Spacing="8">
        <TextBlock Text="Модуль «Медкарта» недоступен"
                   FontWeight="Bold"
                   FontSize="16"
                   Foreground="{DynamicResource OnSurface}" />
        <TextBlock Classes="BodyMedium"
                   Text="Модуль медкарта на данный момент находится в активной разработке."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Button Classes="Text"
                Content="На главную"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource Primary}" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
