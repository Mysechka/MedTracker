<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.MedicalCard"
             x:Class="Med.Ui.Views.Screens.MedicalCardView"
             x:DataType="vm:MedicalCardViewModel">
  <Grid RowDefinitions="Auto,*">

    <!-- Заголовок экрана "Моя медкарта" -->
    <StackPanel Grid.Row="0" Spacing="0">
      <TextBlock Classes="MedScreenTitle" Text="Моя медкарта" />
      <Border Classes="MedHeaderDivider" />
    </StackPanel>

    <!-- Плашка "Модуль недоступен" по Стр. 7 PDF -->
    <Border Grid.Row="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Classes="MedCard"
            CornerRadius="12"
            Padding="24,18"
            MaxWidth="460"
            BoxShadow="0 4 16 0 #20000000"
            Margin="0,0,0,24"
            IsVisible="{Binding ShowDevelopmentNotice}">
      <StackPanel Spacing="8">
        <TextBlock Text="Модуль “Медкарта” недоступен"
                   FontWeight="Bold"
                   FontSize="16"
                   Foreground="{DynamicResource OnSurface}" />
        <TextBlock Text="Модуль медкарта на данный момент находится в активной разработке."
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Button Classes="Text"
                Content="На главную"
                HorizontalAlignment="Left"
                Padding="0"
                Margin="0,4,0,0"
                Foreground="{DynamicResource Primary}" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
