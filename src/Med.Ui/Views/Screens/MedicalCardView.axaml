<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.MedicalCard"
             x:Class="Med.Ui.Views.Screens.MedicalCardView"
             x:DataType="vm:MedicalCardViewModel">
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Заголовок экрана "Моя медкарта" (Стр. 8 PDF) -->
    <DockPanel Grid.Row="0" Margin="24,16,24,12">
      <TextBlock Classes="MedScreenTitle" Text="Моя медкарта" />
    </DockPanel>

    <!-- Разделительная линия во всю ширину панели -->
    <Border Grid.Row="1" Classes="MedHeaderDivider" />

    <!-- Плашка "Модуль “Медкарта” недоступен" внизу по центру (Стр. 8 PDF) -->
    <Border Grid.Row="2"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Classes="MedBottomDialogCard"
            Margin="0,0,0,12"
            IsVisible="{Binding ShowDevelopmentNotice}">
      <StackPanel Spacing="6">
        <TextBlock Text="Модуль “Медкарта” недоступен"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Foreground="#322F37" />
        <TextBlock Text="Модуль медкарта на данный момент находится в активной разработке."
                   TextWrapping="Wrap"
                   FontSize="12"
                   LineHeight="17"
                   Foreground="#49454F" />
        <Button Classes="MedTextLinkBtn"
                Content="На главную"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Left"
                Margin="0,4,0,0" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
