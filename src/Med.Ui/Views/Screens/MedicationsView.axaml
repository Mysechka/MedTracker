<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:Med.Presentation.Medications"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.MedicationsView"
             x:DataType="vm:MedicationsViewModel">

  <Grid>

    <!-- ============================================================ -->
    <!-- 1. ЭКРАН: СПИСОК ЛЕКАРСТВ ("Мои лекарства", Стр. 3 PDF)       -->
    <!-- ============================================================ -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsAdding}">

      <!-- Шапка экрана "Мои лекарства" -->
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right"
                Classes="MedPill"
                Content="+ Добавить"
                Command="{Binding StartNewCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="MedScreenTitle" Text="Мои лекарства" />
          <PathIcon Data="{DynamicResource MedIcon_HeartOutline}"
                    Width="20" Height="20"
                    Foreground="{DynamicResource Primary}"
                    VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Список карточек лекарств -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="12">

          <!-- Пустое состояние (кнопка в центре удалена по требованию) -->
          <controls:EmptyState IsVisible="{Binding IsEmpty}"
                               Icon="{DynamicResource MedIcon_CapsuleAngled}"
                               Header="Лекарств пока нет"
                               Description="Нажмите «+ Добавить», чтобы создать первое лекарство." />

          <!-- Карточки препаратов -->
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MedicationCardViewModel">
                <Border Classes="MedCard" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="*,Auto">

                    <!-- Левая колонка: Название, Описание, Теги времени -->
                    <StackPanel Grid.Column="0" Spacing="6">
                      <TextBlock Classes="TitleLarge"
                                 Text="{Binding Name}"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource OnSurface}" />

                      <TextBlock Classes="BodyMedium"
                                 Text="{Binding Notes}"
                                 Foreground="{DynamicResource OnSurfaceVariant}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                      <!-- Чип дозировки и теги времени (WrapPanel, gap: 8px) -->
                      <ItemsControl ItemsSource="{Binding AllChips}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Outline}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="6,4,12,4"
                                    Margin="0,0,8,8">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{DynamicResource Primary}">
                                  <PathIcon Data="{DynamicResource MedIcon_CapsuleAngled}"
                                            Width="10" Height="10"
                                            Foreground="{DynamicResource OnPrimary}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Classes="LabelMedium"
                                           Text="{Binding}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource OnSurface}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Правая колонка: Меню ≡, Номера и Чекбоксы (1..6), Карандаш ✎ -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                      <!-- Кнопка меню ≡ -->
                      <Button Classes="MedClearBtn"
                              HorizontalAlignment="Right">
                        <PathIcon Data="{DynamicResource MedIcon_Menu}"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource Primary}" />
                      </Button>

                      <!-- Чекбоксы с номерами приемов (динамически от 1 до 6) -->
                      <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CheckboxSlotViewModel">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding Number}"
                                         FontSize="12"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource Primary}"
                                         HorizontalAlignment="Center" />
                              <CheckBox IsChecked="{Binding IsChecked}"
                                        Padding="0"
                                        Margin="0" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Карандаш редактирования -->
                      <Button Classes="MedClearBtn"
                              Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).EditMedicationCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Right">
                        <PathIcon Data="{DynamicResource MedIcon_Pencil}"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource OnSurfaceVariant}" />
                      </Button>
                    </StackPanel>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ============================================================ -->
    <!-- 2. ЭКРАН: ДОБАВИТЬ ЛЕКАРСТВО (Стр. 1 PDF)                    -->
    <!-- ============================================================ -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsAdding}">

      <!-- Шапка экрана "Добавить лекарство" с круглой кнопкой назад ← -->
      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right"
                Classes="MedCircle"
                Command="{Binding BackToListCommand}">
          <PathIcon Data="{DynamicResource MedIcon_ArrowBack}"
                    Width="20" Height="20"
                    Foreground="{DynamicResource OnPrimary}" />
        </Button>
        <TextBlock Classes="MedScreenTitle"
                   Text="Добавить лекарство"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- Форма ввода данных -->
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="14" MaxWidth="540" HorizontalAlignment="Left">

          <!-- Раздел "Информация" -->
          <TextBlock Classes="MedSectionHeader"
                     Text="Информация"
                     Margin="0,4,0,0" />

          <!-- Поле "Название лекарства" -->
          <Grid>
            <TextBox Classes="MedPdfField"
                     Text="{Binding Name}"
                     PlaceholderText="Название лекарства" />
            <Button Classes="MedClearBtn"
                    Command="{Binding ClearNameCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
              <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                        Width="18" Height="18"
                        Foreground="{DynamicResource OnSurfaceVariant}" />
            </Button>
          </Grid>

          <!-- Поле "Описание лекарства" -->
          <Grid>
            <TextBox Classes="MedPdfField"
                     Text="{Binding Notes}"
                     PlaceholderText="Описание лекарства" />
            <Button Classes="MedClearBtn"
                    Command="{Binding ClearNotesCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
              <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                        Width="18" Height="18"
                        Foreground="{DynamicResource OnSurfaceVariant}" />
            </Button>
          </Grid>

          <!-- Поле "Дозировка" -->
          <Grid>
            <TextBox Classes="MedPdfField"
                     Text="{Binding Dosage}"
                     PlaceholderText="Дозировка" />
            <Button Classes="MedClearBtn"
                    Command="{Binding ClearDosageCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0">
              <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                        Width="18" Height="18"
                        Foreground="{DynamicResource OnSurfaceVariant}" />
            </Button>
          </Grid>

          <!-- Раздел "Количество чекбоксов (максимум 6)" -->
          <TextBlock Classes="MedSectionHeader"
                     Text="Количество чекбоксов"
                     Margin="0,10,0,0" />
          <TextBlock Text="Количество отметок приёма в карточке лекарства (максимум 6)"
                     FontSize="13"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     Margin="0,-8,0,6" />

          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Кнопка уменьшения [-] -->
            <Button Classes="MedCircle"
                    Command="{Binding DecrementCheckboxesCommand}"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Content="−"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="0" />

            <!-- Текущее значение -->
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Outline}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="48" Height="36">
              <TextBlock Text="{Binding CheckboxCount}"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Primary}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <!-- Кнопка увеличения [+] -->
            <Button Classes="MedCircle"
                    Command="{Binding IncrementCheckboxesCommand}"
                    Width="36" Height="36"
                    CornerRadius="18"
                    Content="+"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="0" />

            <!-- Быстрый выбор кнопками 1..6 -->
            <ItemsControl ItemsSource="{Binding AvailableCheckboxCounts}" Margin="8,0,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:Int32">
                  <Button Classes="MedCircle"
                          Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).SetCheckboxCountCommand}"
                          CommandParameter="{Binding}"
                          Width="32" Height="32"
                          CornerRadius="16"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Content="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Раздел "Теги времени" -->
          <TextBlock Classes="MedSectionHeader"
                     Text="Теги времени"
                     Margin="0,10,0,0" />
          <TextBlock Text="По умолчанию"
                     FontSize="13"
                     Foreground="{DynamicResource OnSurfaceVariant}"
                     Margin="0,-8,0,4" />

          <!-- Чипы времени по PDF: Утром, Днем, Вечером -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:TagChip Label="Утром" IsSelected="{Binding TimeMorning, Mode=TwoWay}" />
            <controls:TagChip Label="Днем" IsSelected="{Binding TimeAfternoon, Mode=TwoWay}" />
            <controls:TagChip Label="Вечером" IsSelected="{Binding TimeEvening, Mode=TwoWay}" />
          </StackPanel>

          <!-- Кнопка сохранения -->
          <Button Classes="MedPill"
                  Content="Сохранить"
                  Command="{Binding SaveCommand}"
                  Width="180"
                  HorizontalContentAlignment="Center"
                  Margin="0,16,0,0" />

        </StackPanel>
      </ScrollViewer>

    </Grid>

    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 VerticalAlignment="Bottom" />
  </Grid>

</UserControl>
