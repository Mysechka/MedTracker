<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:Med.Presentation.Medications"
             xmlns:controls="using:Med.Ui.Controls"
             x:Class="Med.Ui.Views.Screens.MedicationsView"
             x:DataType="vm:MedicationsViewModel">

  <Grid>

    <!-- ============================================================ -->
    <!-- 1. ЭКРАН: СПИСОК ЛЕКАРСТВ ("Мои лекарства", Стр. 4 PDF)       -->
    <!-- ============================================================ -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding !IsAdding}">

      <!-- Шапка экрана "Мои лекарства" -->
      <DockPanel Grid.Row="0" Margin="24,16,24,12">
        <Button DockPanel.Dock="Right"
                Classes="MedPill"
                Padding="16,8"
                VerticalAlignment="Center"
                Command="{Binding StartNewCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{DynamicResource MedIcon_PlusCircleOutline}"
                      Width="16" Height="16"
                      Foreground="{DynamicResource OnPrimary}"
                      VerticalAlignment="Center" />
            <TextBlock Text="Добавить"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnPrimary}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="MedScreenTitle" Text="Мои лекарства" />
          <PathIcon Data="{DynamicResource MedIcon_HeartOutline}"
                    Width="15" Height="15"
                    Foreground="{DynamicResource MedTitle}"
                    VerticalAlignment="Top"
                    Margin="2,3,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Разделительная линия во всю ширину панели -->
      <Border Grid.Row="1" Classes="MedHeaderDivider" />

      <!-- Список строк лекарств (плоские строки с разделителями по Стр. 4 PDF) -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="0" Background="Transparent" Margin="0,0,0,32">

          <!-- Пустое состояние -->
          <Border Padding="24,28" IsVisible="{Binding IsEmpty}">
            <controls:EmptyState Icon="{DynamicResource MedIcon_AlarmOutline}"
                                 Header="Лекарств пока нет"
                                 Description="Нажмите «Добавить», чтобы создать первое лекарство." />
          </Border>

          <!-- Строки препаратов во всю ширину панели -->
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MedicationCardViewModel">
                <Border Classes="MedMedicationRow"
                        Classes.selected="{Binding IsSelected}">
                  <Grid ColumnDefinitions="*,Auto">

                    <!-- Левая колонка: Название (20px Bold), Описание (14px), Чипы времени с будильником -->
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding Name}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#49454F"
                                           TextWrapping="Wrap" />

                      <SelectableTextBlock Text="{Binding Notes}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#49454F"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,3"
                                           IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                      <!-- Чипы тегов времени ("Утром", "Днем", "Вечером", "До еды") -->
                      <ItemsControl ItemsSource="{Binding DisplayTags}" Margin="0,3,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <Border Classes="MedTagChipStatic"
                                    Margin="0,0,8,4">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{DynamicResource MedIcon_AlarmFilled}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource MedTitle}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#4A3E7E"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- Правая колонка: Чекбоксы (1, 2...) слева и Меню ≡ / Карандаш ✎ справа -->
                    <Grid Grid.Column="1"
                          ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="18"
                          VerticalAlignment="Stretch">

                      <!-- Чекбоксы с номерами приемов сверху (Стр. 4 PDF) -->
                      <ItemsControl Grid.Column="0"
                                    ItemsSource="{Binding Slots}"
                                    VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CheckboxSlotViewModel">
                            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Number}"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         Foreground="{DynamicResource MedTitle}"
                                         HorizontalAlignment="Center" />
                              <CheckBox IsChecked="{Binding IsChecked}"
                                        Padding="0"
                                        Margin="0"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Колонка иконок: Меню ≡ вверху, Карандаш ✎ внизу -->
                      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                        <!-- Кнопка меню ≡ -->
                        <Button Grid.Row="0"
                                Classes="MedClearBtn"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                          <PathIcon Data="{DynamicResource MedIcon_Menu}"
                                    Width="18" Height="15"
                                    Foreground="{DynamicResource MedTitle}" />
                          <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                              <MenuItem Header="Редактировать"
                                        Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).EditMedicationCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Сбросить отметки"
                                        Command="{Binding ResetSlotsCommand}" />
                              <MenuItem Header="Удалить"
                                        Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).DeleteCardCommand}"
                                        CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>

                        <!-- Карандаш редактирования ✎ (появляется при наведении/выделении, Стр. 4 PDF) -->
                        <Button Grid.Row="2"
                                Classes="MedClearBtn MedRowEditBtn"
                                Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).EditMedicationCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,12,0,0">
                          <PathIcon Data="{DynamicResource MedIcon_Pencil}"
                                    Width="16" Height="16"
                                    Foreground="{DynamicResource MedTitle}" />
                        </Button>
                      </Grid>

                    </Grid>

                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ============================================================ -->
    <!-- 2. ЭКРАН: ДОБАВИТЬ / РЕДАКТИРОВАТЬ ЛЕКАРСТВО (Стр. 1 и 2 PDF) -->
    <!-- ============================================================ -->
    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding IsAdding}">
      <Grid.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}" />
      </Grid.KeyBindings>

      <!-- Шапка экрана "Добавить лекарство" с круглой кнопкой назад ← -->
      <DockPanel Grid.Row="0" Margin="24,16,24,12">
        <Button DockPanel.Dock="Right"
                Classes="MedCircle"
                Command="{Binding BackToListCommand}">
          <PathIcon Data="{DynamicResource MedIcon_ArrowBack}"
                    Width="18" Height="18"
                    Foreground="{DynamicResource OnPrimary}" />
        </Button>
        <TextBlock Classes="MedScreenTitle"
                   Text="Добавить лекарство"
                   VerticalAlignment="Center" />
      </DockPanel>

      <!-- Разделительная линия во всю ширину панели -->
      <Border Grid.Row="1" Classes="MedHeaderDivider" />

      <!-- Скроллируемая двухколоночная область формы и календаря (Стр. 1 и Стр. 2 PDF) -->
      <ScrollViewer Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnDefinitions="*,Auto"
              Background="Transparent"
              Margin="24,14,24,48">

          <!-- Левая колонка: Информация, Теги времени, Приём лекарства курсом, Количество чекбоксов, Сохранить -->
          <StackPanel Grid.Column="0"
                      Spacing="12"
                      Background="Transparent"
                      HorizontalAlignment="Left">

            <!-- Раздел "Информация" -->
            <TextBlock Classes="MedSectionHeader"
                       Text="Информация" />

            <!-- Поле "Название лекарства" (Material 3 Filled TextField) -->
            <Border Classes="MedM3Field" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                  <TextBlock Text="Название лекарства"
                             FontSize="11"
                             Foreground="#49454F"
                             IsHitTestVisible="False" />
                  <TextBox Classes="MedM3Input"
                           MaxLength="50"
                           Text="{Binding Name}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="MedClearBtn"
                        Command="{Binding ClearNameCommand}"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                  <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                            Width="18" Height="18"
                            Foreground="#49454F" />
                </Button>
              </Grid>
            </Border>

            <!-- Поле "Описание лекарства" (Material 3 Filled TextField) -->
            <Border Classes="MedM3Field" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                  <TextBlock Text="Описание лекарства"
                             FontSize="11"
                             Foreground="#49454F"
                             IsHitTestVisible="False" />
                  <TextBox Classes="MedM3Input"
                           MaxLength="50"
                           Text="{Binding Notes}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="MedClearBtn"
                        Command="{Binding ClearNotesCommand}"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                  <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                            Width="18" Height="18"
                            Foreground="#49454F" />
                </Button>
              </Grid>
            </Border>

            <!-- Поле "Дозировка" (Material 3 Filled TextField) -->
            <Border Classes="MedM3Field" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
                  <TextBlock Text="Дозировка"
                             FontSize="11"
                             Foreground="#49454F"
                             IsHitTestVisible="False" />
                  <TextBox Classes="MedM3Input"
                           Text="{Binding Dosage}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="MedClearBtn"
                        Command="{Binding ClearDosageCommand}"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                  <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                            Width="18" Height="18"
                            Foreground="#49454F" />
                </Button>
              </Grid>
            </Border>

            <!-- Раздел "Теги времени" -->
            <StackPanel Spacing="2" Margin="0,2,0,0">
              <TextBlock Classes="MedSectionHeader"
                         Text="Теги времени" />
              <TextBlock Text="По умолчанию"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="#49454F"
                         Margin="0,0,0,6" />

              <!-- Чипы времени по PDF: Утром, Днем, Вечером -->
              <WrapPanel Orientation="Horizontal">
                <controls:TagChip Label="Утром" IsSelected="{Binding TimeMorning, Mode=TwoWay}" Margin="0,0,8,6" />
                <controls:TagChip Label="Днем" IsSelected="{Binding TimeAfternoon, Mode=TwoWay}" Margin="0,0,8,6" />
                <controls:TagChip Label="Вечером" IsSelected="{Binding TimeEvening, Mode=TwoWay}" Margin="0,0,8,6" />
              </WrapPanel>
            </StackPanel>

            <!-- Раздел "Приём лекарства курсом" с кастомным Material 3 Switch -->
            <StackPanel Spacing="8" Margin="0,2,0,0">
              <TextBlock Classes="MedSectionHeader"
                         Text="Приём лекарства курсом" />
              <ToggleSwitch Classes="MedM3Switch"
                            IsChecked="{Binding IsCourseMode, Mode=TwoWay}"
                            HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Раздел "Количество чекбоксов (1..6)" -->
            <StackPanel Spacing="4" Margin="0,4,0,0">
              <TextBlock Classes="MedSectionHeader"
                         Text="Количество чекбоксов" />
              <TextBlock Text="Отметки приёма в карточке (максимум 6)"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="#49454F"
                         Margin="0,0,0,4" />

              <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,4">
                  <Button Classes="MedCircle"
                          Command="{Binding DecrementCheckboxesCommand}"
                          Width="30" Height="30"
                          CornerRadius="15"
                          Content="−"
                          FontSize="16"
                          FontWeight="Bold"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />

                  <Border Background="#FFFFFF"
                          BorderBrush="{DynamicResource Outline}"
                          BorderThickness="1"
                          CornerRadius="8"
                          Width="40" Height="30">
                    <TextBlock Text="{Binding CheckboxCount}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Primary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>

                  <Button Classes="MedCircle"
                          Command="{Binding IncrementCheckboxesCommand}"
                          Width="30" Height="30"
                          CornerRadius="15"
                          Content="+"
                          FontSize="16"
                          FontWeight="Bold"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding AvailableCheckboxCounts}" VerticalAlignment="Center" Margin="0,0,0,4">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:Int32">
                      <Button Classes="MedCircle"
                              Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).SetCheckboxCountCommand}"
                              CommandParameter="{Binding}"
                              Width="28" Height="28"
                              CornerRadius="14"
                              FontSize="12"
                              FontWeight="SemiBold"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Content="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
            </StackPanel>

            <!-- Кнопка сохранения (после нажатия сохраняет и возвращает в список "Мои лекарства") -->
            <Button Classes="MedPill"
                    Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    MinWidth="150"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,16" />

          </StackPanel>

          <!-- Правая колонка: Material 3 DatePicker карточка на русском языке (видна при включении курса) -->
          <Border Grid.Column="1"
                  Background="#FCF9FF"
                  BorderBrush="#DFD5EC"
                  BorderThickness="1"
                  CornerRadius="22"
                  Width="296"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="20,0,0,0"
                  BoxShadow="0 8 24 0 #1A4A3E7E"
                  ClipToBounds="True"
                  IsVisible="{Binding IsCourseMode}">
            <StackPanel Spacing="0">

              <!-- Верхняя шапка DatePicker: "Дата окончания курса" и выбранная дата на русском -->
              <Border Background="#F3ECFA"
                      Padding="18,14,16,12"
                      BorderBrush="#E2D9F0"
                      BorderThickness="0,0,0,1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Дата окончания курса"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource MedTitle}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CourseEndsOnHeaderText}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1D1B20"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Width="32" Height="32"
                            CornerRadius="16"
                            Background="#E8DEF8"
                            VerticalAlignment="Center">
                      <PathIcon Data="{DynamicResource MedIcon_Calendar}"
                                Width="16" Height="16"
                                Foreground="{DynamicResource MedTitle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                  <Border Background="#E8DEF8"
                          CornerRadius="10"
                          Padding="10,3"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding CourseDurationSummaryText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#4A3E7E" />
                  </Border>
                </StackPanel>
              </Border>

              <!-- Навигация по месяцам: "Ноябрь 2026" и стрелки "< >" -->
              <Grid ColumnDefinitions="*,Auto" Margin="18,12,12,8">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding CalendarMonthYearTitle}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="#1D1B20"
                             VerticalAlignment="Center" />
                  <PathIcon Data="{DynamicResource MedIcon_CaretDown}"
                            Width="9" Height="9"
                            Foreground="{DynamicResource MedTitle}"
                            VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                  <Button Classes="MedClearBtn"
                          Width="30" Height="30"
                          CornerRadius="15"
                          ToolTip.Tip="Предыдущий месяц"
                          Command="{Binding PreviousMonthCommand}">
                    <PathIcon Data="{DynamicResource MedIcon_ChevronLeft}"
                              Width="16" Height="16"
                              Foreground="#49454F" />
                  </Button>
                  <Button Classes="MedClearBtn"
                          Width="30" Height="30"
                          CornerRadius="15"
                          ToolTip.Tip="Следующий месяц"
                          Command="{Binding NextMonthCommand}">
                    <PathIcon Data="{DynamicResource MedIcon_ChevronRight}"
                              Width="16" Height="16"
                              Foreground="#49454F" />
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Заголовки дней недели по-русски (с понедельника): Пн Вт Ср Чт Пт Сб Вс -->
              <UniformGrid Columns="7" Rows="1" Margin="12,0,12,6">
                <TextBlock Text="Пн" FontSize="11" FontWeight="SemiBold" Foreground="#79747E" HorizontalAlignment="Center" />
                <TextBlock Text="Вт" FontSize="11" FontWeight="SemiBold" Foreground="#79747E" HorizontalAlignment="Center" />
                <TextBlock Text="Ср" FontSize="11" FontWeight="SemiBold" Foreground="#79747E" HorizontalAlignment="Center" />
                <TextBlock Text="Чт" FontSize="11" FontWeight="SemiBold" Foreground="#79747E" HorizontalAlignment="Center" />
                <TextBlock Text="Пт" FontSize="11" FontWeight="SemiBold" Foreground="#79747E" HorizontalAlignment="Center" />
                <TextBlock Text="Сб" FontSize="11" FontWeight="SemiBold" Foreground="#98677C" HorizontalAlignment="Center" />
                <TextBlock Text="Вс" FontSize="11" FontWeight="SemiBold" Foreground="#98677C" HorizontalAlignment="Center" />
              </UniformGrid>

              <!-- Сетка чисел месяца -->
              <ItemsControl ItemsSource="{Binding CalendarDays}" Margin="12,0,12,14">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarDayCellViewModel">
                    <Panel Width="36" Height="36" Margin="0,1">
                      <Button Classes="MedCalendarDayBtn"
                              Classes.selected="{Binding IsSelected}"
                              Classes.today="{Binding IsToday}"
                              Classes.weekend="{Binding IsWeekend}"
                              IsVisible="{Binding !IsEmpty}"
                              Content="{Binding Label}"
                              Command="{Binding $parent[UserControl].((vm:MedicationsViewModel)DataContext).SelectCalendarDateCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>

        </Grid>
      </ScrollViewer>

    </Grid>

    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 VerticalAlignment="Bottom" />
  </Grid>

</UserControl>
