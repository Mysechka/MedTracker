<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             x:Class="Med.Ui.Views.Screens.AuthView"
             x:DataType="vm:AuthViewModel">

  <StackPanel Spacing="0">

    <!-- Заголовок экрана -->
    <TextBlock Classes="MedScreenTitle"
               Text="Регистрация"
               IsVisible="{Binding IsRegistrationMode}" />
    <TextBlock Classes="MedScreenTitle"
               Text="Вход"
               IsVisible="{Binding !IsRegistrationMode}" />

    <!-- Разделительная линия -->
    <Border Classes="MedHeaderDivider" />

    <!-- Форма ввода данных -->
    <StackPanel Spacing="0" MaxWidth="380" HorizontalAlignment="Left" Margin="0,8,0,0">

      <!-- Поле Имя пользователя -->
      <StackPanel Spacing="6" Margin="0,0,0,14">
        <TextBlock Text="Имя пользователя"
                   FontSize="14"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Grid>
          <TextBox Classes="MedPdfField"
                   Text="{Binding Username}"
                   Watermark="Ваше имя (например: Иван или ivan)" />
          <Button Classes="MedClearBtn"
                  Command="{Binding ClearUsernameCommand}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0">
            <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                      Width="18" Height="18"
                      Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Поле Кодовое слово -->
      <StackPanel Spacing="6" Margin="0,0,0,16">
        <TextBlock Text="Кодовое слово"
                   FontSize="14"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Grid>
          <TextBox Classes="MedPdfField"
                   Text="{Binding Password}"
                   PasswordChar="•"
                   Watermark="Секретное слово (от 6 символов)" />
          <Button Classes="MedClearBtn"
                  Command="{Binding ClearPasswordCommand}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0">
            <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                      Width="18" Height="18"
                      Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Сообщение об ошибке -->
      <TextBlock Text="{Binding ErrorMessage}"
                 FontSize="13"
                 Foreground="#FFD32F2F"
                 TextWrapping="Wrap"
                 Margin="0,0,0,16"
                 IsVisible="{Binding ErrorMessage.Length}" />

      <!-- Кнопки действий -->
      <StackPanel Spacing="12" HorizontalAlignment="Left">
        <!-- Кнопки режима Регистрация -->
        <Button Classes="MedPill"
                Content="Зарегистрироваться"
                Command="{Binding SignUpCommand}"
                IsVisible="{Binding IsRegistrationMode}"
                MinWidth="210"
                HorizontalContentAlignment="Center" />
        <Button Classes="MedPill"
                Content="Войти в аккаунт"
                Command="{Binding ShowLoginCommand}"
                IsVisible="{Binding IsRegistrationMode}"
                MinWidth="180"
                HorizontalContentAlignment="Center" />

        <!-- Кнопки режима Вход -->
        <Button Classes="MedPill"
                Content="Войти"
                Command="{Binding SignInCommand}"
                IsVisible="{Binding !IsRegistrationMode}"
                MinWidth="160"
                HorizontalContentAlignment="Center" />
        <Button Classes="MedPill"
                Content="Создать аккаунт"
                Command="{Binding ShowRegistrationCommand}"
                IsVisible="{Binding !IsRegistrationMode}"
                MinWidth="180"
                HorizontalContentAlignment="Center" />
      </StackPanel>

    </StackPanel>

    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 Margin="0,16,0,0" />

  </StackPanel>
</UserControl>
