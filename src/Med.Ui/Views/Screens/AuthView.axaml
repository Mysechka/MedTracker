<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             x:Class="Med.Ui.Views.Screens.AuthView"
             x:DataType="vm:AuthViewModel">

  <StackPanel Spacing="0">

    <!-- Заголовок экрана -->
    <TextBlock Classes="MedScreenTitle"
               Text="Добро пожаловать" />

    <!-- Разделительная линия -->
    <Border Classes="MedHeaderDivider" />

    <!-- Описание -->
    <TextBlock Text="Введите ваше имя или никнейм, чтобы начать пользоваться приложением:"
               FontSize="13"
               TextWrapping="Wrap"
               Foreground="{DynamicResource OnSurfaceVariant}"
               Margin="0,8,0,16" />

    <!-- Форма ввода данных -->
    <StackPanel Spacing="0" MaxWidth="380" HorizontalAlignment="Left">

      <!-- Поле Никнейм -->
      <StackPanel Spacing="6" Margin="0,0,0,16">
        <TextBlock Text="Никнейм"
                   FontSize="14"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Grid>
          <TextBox Classes="MedPdfField"
                   Text="{Binding Username}"
                   PlaceholderText="Ваше имя или никнейм" />
          <Button Classes="MedClearBtn"
                  Command="{Binding ClearUsernameCommand}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0">
            <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                      Width="18" Height="18"
                      Foreground="{DynamicResource OnSurfaceVariant}" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Сообщение об ошибке -->
      <TextBlock Text="{Binding ErrorMessage}"
                 FontSize="13"
                 Foreground="#FFD32F2F"
                 TextWrapping="Wrap"
                 Margin="0,0,0,16"
                 IsVisible="{Binding ErrorMessage.Length}" />

      <!-- Кнопка Начать -->
      <Button Classes="MedPill"
              Content="Начать"
              Command="{Binding StartLocalCommand}"
              MinWidth="160"
              HorizontalContentAlignment="Center" />

    </StackPanel>

    <ProgressBar IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 Margin="0,16,0,0" />

  </StackPanel>
</UserControl>
