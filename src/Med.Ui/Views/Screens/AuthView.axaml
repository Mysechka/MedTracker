<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Shell"
             x:Class="Med.Ui.Views.Screens.AuthView"
             x:DataType="vm:AuthViewModel">

  <Grid RowDefinitions="Auto,Auto,*">
    <Grid.KeyBindings>
      <KeyBinding Gesture="Enter" Command="{Binding StartLocalCommand}" />
    </Grid.KeyBindings>

    <!-- Заголовок экрана первичной локальной регистрации -->
    <DockPanel Grid.Row="0" Margin="24,16,24,12">
      <TextBlock Classes="MedScreenTitle" Text="Регистрация" />
    </DockPanel>

    <!-- Разделительная линия во всю ширину панели -->
    <Border Grid.Row="1" Classes="MedHeaderDivider" />

    <!-- Первичная регистрация: только Никнейм (привязка почты и пароля позже в разделе "Аккаунт") -->
    <ScrollViewer Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14"
                  Background="Transparent"
                  Margin="24,20,24,24"
                  MaxWidth="380"
                  HorizontalAlignment="Left">

        <TextBlock Text="Введите ваше имя или никнейм, чтобы начать пользоваться приложением. Привязать почту и ботов можно позже в разделе «Аккаунт»."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="#49454F" />

        <!-- Поле: Имя пользователя (Material 3 Filled TextField) -->
        <Border Classes="MedM3Field" Width="260" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Center">
              <TextBlock Text="Имя пользователя"
                         FontSize="11"
                         Foreground="#49454F"
                         IsHitTestVisible="False" />
              <TextBox Classes="MedM3Input"
                       MaxLength="20"
                       Text="{Binding Username}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="MedClearBtn"
                    Command="{Binding ClearUsernameCommand}"
                    VerticalAlignment="Center"
                    Margin="4,0,0,0">
              <PathIcon Data="{DynamicResource MedIcon_ClearCircle}"
                        Width="18" Height="18"
                        Foreground="#49454F" />
            </Button>
          </Grid>
        </Border>

        <!-- Сообщение об ошибке -->
        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="12"
                   Foreground="#BA1A1A"
                   TextWrapping="Wrap"
                   MaxWidth="280"
                   IsVisible="{Binding ErrorMessage.Length}" />

        <!-- Кнопка "Начать" для мгновенного локального входа -->
        <Button Classes="MedPill"
                Content="Начать"
                Command="{Binding StartLocalCommand}"
                MinWidth="150"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Center"
                Margin="0,4,0,0" />

        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="3"
                     Width="260"
                     HorizontalAlignment="Left"
                     Margin="0,8,0,0" />

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
