<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Settings"
             xmlns:controls="using:Med.Ui.Controls"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="Med.Ui.Views.Screens.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="16">

    <DockPanel>
      <Button DockPanel.Dock="Left"
              Classes="Text"
              Content="←"
              Command="{Binding BackToMenuCommand}"
              IsVisible="{Binding ShowBack}"
              Margin="0,0,8,0" />
      <TextBlock Classes="MedScreenTitle" Text="Настройки" VerticalAlignment="Center" />
    </DockPanel>
    <Border Height="1" Background="{DynamicResource Outline}" />

    <StackPanel Spacing="4" IsVisible="{Binding ShowMenu}">
      <Button Classes="MedSettingsItem"
              Content="Приемы пищи"
              Command="{Binding OpenMealsSectionCommand}" />
      <Button Classes="MedSettingsItem"
              Content="Привязка мессенджеров"
              Command="{Binding OpenMessengersSectionCommand}" />
      <Button Classes="MedSettingsItem"
              Content="Диагностика"
              Command="{Binding OpenDiagnosticsSectionCommand}" />
    </StackPanel>

    <StackPanel Spacing="12" IsVisible="{Binding ShowMeals}">
      <TextBox Classes="Outlined" PlaceholderText="Имя пользователя" Text="{Binding Username}" />
      <TextBox Classes="Outlined" PlaceholderText="Москва ± N часов" Text="{Binding MoscowOffsetHours}" />
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <TextBox Grid.Column="0" Classes="Outlined" PlaceholderText="Завтрак" Text="{Binding Breakfast}" />
        <TextBox Grid.Column="1" Classes="Outlined" PlaceholderText="Обед" Text="{Binding Lunch}" />
        <TextBox Grid.Column="2" Classes="Outlined" PlaceholderText="Ужин" Text="{Binding Dinner}" />
      </Grid>
      <Button Classes="MedPill"
              Content="Сохранить профиль"
              Command="{Binding SaveProfileCommand}"
              HorizontalAlignment="Left" />
    </StackPanel>

    <StackPanel Spacing="12" IsVisible="{Binding ShowMessengers}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="MedPill" Content="Код Telegram" Command="{Binding GenerateTelegramCodeCommand}" />
        <Button Classes="MedPill" Content="Код Discord" Command="{Binding GenerateDiscordCodeCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding TelegramLinkCode}"
                 IsVisible="{Binding TelegramLinkCode, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
      <controls:EmptyState IsVisible="{Binding IsLinksEmpty}"
                           Icon="{DynamicResource Material_IconLink}"
                           Header="Каналы не привязаны"
                           Description="Сгенерируйте код и отправьте его боту."
                           ActionText="Код Telegram"
                           ActionCommand="{Binding GenerateTelegramCodeCommand}" />
      <ListBox ItemsSource="{Binding Links}" IsVisible="{Binding !IsLinksEmpty}" MinHeight="80" />
    </StackPanel>

    <ContentControl Content="{Binding Diagnostics}" IsVisible="{Binding ShowDiagnostics}" />

    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
  </StackPanel>
</UserControl>
