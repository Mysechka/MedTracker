<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Med.Presentation.Settings"
             x:Class="Med.Ui.Views.Screens.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Заголовок настроек -->
    <StackPanel Grid.Row="0" Spacing="0">
      <TextBlock Classes="MedScreenTitle" Text="Настройки" />
      <Border Classes="MedHeaderDivider" />
    </StackPanel>

    <!-- Основное содержимое экрана настроек (Стр. 2 PDF) -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="24" MaxWidth="520" HorizontalAlignment="Left">

        <!-- Раздел: Приемы пищи -->
        <StackPanel Spacing="10">
          <TextBlock Classes="MedSectionHeader" Text="Приемы пищи" />

          <!-- Сетка заголовков и полей времени: Завтрак, Обед, Ужин -->
          <Grid ColumnDefinitions="110,110,110" ColumnSpacing="16">
            <!-- Завтрак -->
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="Завтрак"
                         FontSize="13"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <Border Classes="MedCard"
                      Padding="10,6"
                      Height="40">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding Breakfast}"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="0"
                           VerticalAlignment="Center"
                           FontSize="14" />
                  <PathIcon Grid.Column="1"
                            Data="{DynamicResource MedIcon_ChevronDown}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource OnSurface}"
                            VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Обед -->
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock Text="Обед"
                         FontSize="13"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <Border Classes="MedCard"
                      Padding="10,6"
                      Height="40">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding Lunch}"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="0"
                           VerticalAlignment="Center"
                           FontSize="14" />
                  <PathIcon Grid.Column="1"
                            Data="{DynamicResource MedIcon_ChevronDown}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource OnSurface}"
                            VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>

            <!-- Ужин -->
            <StackPanel Grid.Column="2" Spacing="6">
              <TextBlock Text="Ужин"
                         FontSize="13"
                         Foreground="{DynamicResource OnSurfaceVariant}" />
              <Border Classes="MedCard"
                      Padding="10,6"
                      Height="40">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding Dinner}"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="0"
                           VerticalAlignment="Center"
                           FontSize="14" />
                  <PathIcon Grid.Column="1"
                            Data="{DynamicResource MedIcon_ChevronDown}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource OnSurface}"
                            VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Раздел: Привязка мессенджеров -->
        <StackPanel Spacing="12">
          <TextBlock Classes="MedSectionHeader" Text="Привязка мессенджеров" />

          <!-- Кнопки генерации кодов мессенджеров -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="MedPill"
                    Content="Код Telegram"
                    Command="{Binding GenerateTelegramCodeCommand}" />
            <Button Classes="MedPill"
                    Content="Код Discord"
                    Command="{Binding GenerateDiscordCodeCommand}" />
          </StackPanel>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Всплывающая плашка кода привязки мессенджера (Стр. 6 PDF) -->
    <Border Grid.Row="2"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Classes="MedCard"
            CornerRadius="12"
            Padding="20,16"
            MaxWidth="380"
            Margin="0,16,0,0"
            BoxShadow="0 4 16 0 #20000000"
            IsVisible="{Binding TelegramLinkCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding TelegramLinkCode, StringFormat='{}Код привязки {0}'}"
                   FontWeight="Bold"
                   FontSize="15"
                   Foreground="{DynamicResource OnSurface}" />
        <TextBlock Text="введите команду /link"
                   FontSize="13"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <TextBlock Text="{Binding TelegramLinkCode, StringFormat='{}${0}'}"
                   FontSize="13"
                   Foreground="{DynamicResource OnSurfaceVariant}" />
        <Button Classes="Text"
                Content="Открыть чат с ботом"
                HorizontalAlignment="Left"
                Padding="0"
                Margin="0,4,0,0"
                Foreground="{DynamicResource Primary}" />
      </StackPanel>
    </Border>

    <ProgressBar Grid.Row="2"
                 IsIndeterminate="True"
                 IsVisible="{Binding IsBusy}"
                 Height="3"
                 VerticalAlignment="Bottom" />

  </Grid>

</UserControl>
