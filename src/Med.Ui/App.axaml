<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Med.Ui"
             xmlns:theme="using:CCSWE.Avalonia.Material"
             x:Class="Med.Ui.App"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="RobotoFontFamily">avares://Med.Ui/Assets/Fonts#Roboto</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Med.Ui/Theme/MedIcons.axaml" />
        <ResourceInclude Source="avares://Med.Ui/Theme/MedPurpleTheme.axaml" />
        <ResourceInclude Source="avares://Med.Ui/Controls/EmptyState.axaml" />
        <ResourceInclude Source="avares://Med.Ui/Controls/TagChip.axaml" />
        <ResourceInclude Source="avares://Med.Ui/Controls/SideNavItem.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <theme:MaterialTheme />
    <StyleInclude Source="avares://Med.Ui/Theme/MedStyles.axaml" />
    <Style Selector=":is(TopLevel)">
      <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource RobotoFontFamily}" />
    </Style>
  </Application.Styles>

</Application>
