# Шаблон переменных окружения. Реальные значения в репозиторий не попадают никогда.
# Скопировать в .env (он в .gitignore) и заполнить.

# ---------------------------------------------------------------------------
# Клиентское приложение (Med.Desktop / Med.Android)
# Здесь допустим ТОЛЬКО anon key. service_role в клиенте недопустим.
# Двойное подчёркивание — разделитель секций конфигурации .NET.
# ---------------------------------------------------------------------------
MEDTRACKER_Supabase__Url=https://<project-ref>.supabase.co
MEDTRACKER_Supabase__AnonKey=

# ---------------------------------------------------------------------------
# Edge Functions (tick, telegram-webhook, discord-interactions).
# Задаются через `supabase secrets set`, а не в клиенте.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
# Секрет, который Telegram присылает в заголовке X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Discord: основной режим — приложение с Interactions Endpoint URL и кнопками.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Режим деградации: обычный webhook без кнопок, только текст.
DISCORD_WEBHOOK_URL=
